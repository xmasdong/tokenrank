@import "../../styles/upstream.wxss";
.page { padding: 16px 0 calc(32px + env(safe-area-inset-bottom)); }
.head { padding: 0 16px 16px; }
.sub { font-size: 13px; color: var(--text-secondary); line-height: 1.7; }
.os-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin: 0 16px; }
.os-label { font-size: 14px; color: var(--text-secondary); }
.os-toggle { display: flex; gap: 8px; margin-left: auto; }
.os-toggle .os-opt { display: flex; align-items: center; justify-content: center; min-height: 44px; width: auto; margin: 0; padding: 8px 16px; box-sizing: border-box; color: var(--text-secondary); background: #F2F2F2; border: none; border-radius: 6px; font-size: 14px; font-weight: 400; line-height: 1.5; }
.os-opt::after { border: none; }
.os-toggle .os-active { background: var(--primary); color: #FFFFFF; font-weight: 500; }
.cmd-box { margin: 16px; background: var(--surface-muted); border-radius: 6px; padding: 12px; }
.cmd { color: var(--text); font-family: Menlo, Consolas, monospace; font-size: 12px; line-height: 1.8; word-break: break-all; }
.command-state { margin: 16px; padding: 12px 0; font-size: 14px; color: var(--text-secondary); line-height: 1.7; }
.page .wide { width: auto; margin-left: 16px; margin-right: 16px; }
.page .command-state .wide { width: 100%; margin: 16px 0 0; }
.command-state .error-note { margin: 0; }
.note { margin: 10px 16px 0; color: var(--text-muted); font-size: 12px; line-height: 1.7; }
.steps { padding: 20px 16px 4px; }
.step { display: flex; gap: 12px; font-size: 14px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 12px; }
.step-no { flex: none; color: var(--text-secondary); width: 16px; text-align: center; font-size: 14px; font-weight: 400; }
.step-body { flex: 1; min-width: 0; }
.sync-section { margin: 20px 16px 0; padding-top: 20px; border-top: 1rpx solid var(--separator); }
.section-title, .ai-title { font-size: 17px; font-weight: 500; }
.status { display: flex; align-items: center; gap: 6px; margin-top: 12px; color: var(--text-secondary); font-size: 14px; line-height: 1.7; }
.dot { width: 5px; height: 5px; flex: none; border-radius: 50%; background: var(--primary); }
.status-pending .dot, .status-stale .dot, .status-error .dot, .status-stopped .dot { background: var(--danger); }
.sync-times { margin-top: 12px; padding-top: 8px; border-top: 1rpx solid var(--separator); }
.sync-time { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 4px 0; color: var(--text-secondary); font-size: 13px; line-height: 1.7; }
.pending-note, .error-note { margin: 8px 0 0; color: var(--text-secondary); font-size: 13px; line-height: 1.7; }
.error-note { color: var(--danger); }
.sync-section .wide { width: 100%; margin: 16px 0 0; }
.ai-card { margin: 24px 16px 0; padding-top: 20px; border-top: 1rpx solid var(--separator); }
.ai-title { margin-bottom: 10px; }
.ai-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 12px; }
.ai-card .btn { width: 100%; }
.audit { display: block; background: var(--surface-muted); border-radius: 6px; padding: 12px; margin-top: 16px; color: var(--text-secondary); font-size: 12px; line-height: 1.8; white-space: pre-wrap; word-break: break-all; }
.ai-btn { margin-top: 12px; }
.upstream-intro { margin: 24px 16px 0; }
.about-link, .board-link { display: flex; align-items: center; min-height: 44px; margin: 12px 16px 0; color: var(--link); font-size: 14px; line-height: 1.7; }
.advanced { margin: 16px; padding-top: 20px; border-top: 1rpx solid var(--separator); }
.advanced .btn { width: 100%; margin: 12px 0; }
.privacy { margin: 20px 16px 0; padding: 16px 0; border-top: 1rpx solid var(--separator); border-bottom: 1rpx solid var(--separator); }
.privacy-line { font-size: 13px; color: var(--text-secondary); line-height: 1.8; }
.privacy-strong { margin-top: 12px; color: var(--text); font-weight: 500; }
.privacy-cmd { margin: 8px 0; padding: 10px 12px; border-radius: 6px; background: var(--surface-muted); color: var(--text); font-family: Menlo, Consolas, monospace; font-size: 12px; word-break: break-all; }
