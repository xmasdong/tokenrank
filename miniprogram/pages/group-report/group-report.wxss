.report-page{padding-bottom:calc(32rpx + env(safe-area-inset-bottom));}.heading{padding:32rpx 32rpx 20rpx;}.group-name{font-size:40rpx;font-weight:500;word-break:break-all;}.sub{font-size:24rpx;line-height:1.7;color:#999;white-space:pre-line;}.range{padding:24rpx 32rpx 0;font-size:24rpx;color:#999;}.summary{padding:18rpx 32rpx 28rpx;}.token-number{color:#D88A2D;font-size:80rpx;line-height:1.3;overflow-wrap:anywhere;}.token-unit{font-size:40rpx;margin-left:12rpx;}.metrics{display:flex;justify-content:space-between;gap:24rpx;margin-top:32rpx;}.metric-column{min-width:0;}.metric-value{font-size:36rpx;overflow-wrap:anywhere;font-variant-numeric:tabular-nums;}.metric-unit{font-size:26rpx;}.cost-note{margin-top:20rpx;}.share-actions{display:flex;gap:16rpx;padding:0 32rpx 32rpx;}.share-actions .btn{flex:1;min-width:0;margin:0;font-size:28rpx;}.section{padding:32rpx;border-top:16rpx solid #F7F7F7;}.section-title{font-size:32rpx;font-weight:500;}.composition{display:flex;flex-wrap:wrap;gap:24rpx;margin-top:24rpx;}.composition-row{width:100%;box-sizing:border-box;display:flex;justify-content:space-between;gap:8rpx;font-size:26rpx;}.composition-label{color:#999;}.composition-amount{font-variant-numeric:tabular-nums;}.dimension-tabs{margin-top:24rpx;}.category{padding:24rpx 0;border-bottom:1rpx solid #EDEDED;}.category-main,.category-meta,.selected-day{display:flex;justify-content:space-between;gap:16rpx;}.category-title{display:flex;align-items:center;gap:12rpx;min-width:0;word-break:break-all;font-size:28rpx;}.color-dot{width:12rpx;height:12rpx;border-radius:50%;flex:none;}.category-percent{color:#666;font-size:28rpx;}.category-meta{font-size:22rpx;line-height:1.7;color:#999;margin-top:8rpx;}.category-amount{text-align:right;flex-shrink:0;}.bar-track{height:6rpx;background:#F7F7F7;margin-top:16rpx;}.bar{height:6rpx;}.state{padding:80rpx 32rpx;text-align:center;color:#999;}.state .btn{margin-top:32rpx;}.state.small{padding:32rpx;}.text-button,.retry{padding:16rpx 0;background:transparent;color:#576B95;font-size:26rpx;}.text-button::after,.retry::after{border:0;}.retry{margin:0 32rpx;}.selection{padding:16rpx 20rpx;background:#F7F7F7;font-size:26rpx;line-height:1.7;word-break:break-all;}.selected-day{padding:20rpx 0;font-size:24rpx;line-height:1.7;}.selected-day-amount{text-align:right;}.coverage{padding:28rpx 32rpx;color:#999;font-size:23rpx;line-height:1.8;border-top:1rpx solid #EDEDED;}.cta{padding:16rpx 32rpx 32rpx;}
