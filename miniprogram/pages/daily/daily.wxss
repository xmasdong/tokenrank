.page { padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
.state { margin: 32px 16px; color: var(--text-secondary); font-size: 14px; }
.state .btn { margin-top: 16px; }
.day-nav { display: flex; align-items: center; justify-content: space-between; padding: 8px 16px; border-bottom: 1rpx solid var(--separator); }
.day-nav > text { font-size: 16px; font-weight: 500; }
.day-nav button { width: auto; min-height: 44px; padding: 8px 0; margin: 0; background: transparent; color: var(--link); font-size: 14px; line-height: 28px; }
.day-nav button::after, .text-button::after { border: none; }
.day-nav button[disabled] { color: var(--separator-strong); }
.summary { padding: 24px 16px; }
.label, .exact, .footnote { font-size: 12px; color: var(--text-secondary); line-height: 1.8; }
.amount { margin: 6px 0; font-size: 42px; line-height: 1.3; color: var(--amount); }
.amount text { margin-left: 4px; font-size: 25px; }
.calls { display: flex; align-items: center; justify-content: space-between; margin-top: 20px; font-size: 15px; }
.calls text + text { font-size: 20px; }
.section { padding: 20px 16px; border-top: 1rpx solid var(--separator); }
.section-title { margin-bottom: 12px; font-size: 16px; font-weight: 500; }
.primary-row, .detail-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; min-height: 36px; font-size: 13px; }
.primary-row > text:first-child, .detail-row > text:first-child { color: var(--text-secondary); min-width: 0; overflow-wrap: anywhere; }
.primary-row > text + text { min-width: 0; max-width: 80%; text-align: right; overflow-wrap: anywhere; }
.detail-row > text + text { flex-shrink: 0; font-variant-numeric: tabular-nums; }
.breakdown { margin-bottom: 12px; }
.track { height: 3px; background: var(--separator); }
.track > view { height: 100%; background: var(--amount); }
.footnote { margin: 0 16px 20px; }
.entries { border-top: 1rpx solid var(--separator); }
.text-button { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 10px 0; margin: 0 16px; color: var(--link); background: transparent; font-size: 14px; font-weight: 400; line-height: 28px; }
.entries .text-button { border-bottom: 1rpx solid var(--separator); }
.renewal { padding: 20px 16px 0; border-top: 1rpx solid var(--separator); }
.renewal-title { font-size: 16px; font-weight: 500; }
.renewal-note, .renewal-notice { margin-top: 10px; color: var(--text-secondary); font-size: 13px; line-height: 1.8; }
.renewal .btn { width: 100%; margin: 14px 0 0; }
.renewal-footnote { margin-top: 8px; color: var(--text-muted); font-size: 12px; }
.renewal-notice { color: var(--text); }
.renewal .error { color: var(--danger); }
.manage-reminder { margin: 0; font-size: 13px; }
.daily-sharing { padding: 0 16px 24px; }
.share-actions { display:flex; gap:12px; }
.share-actions .btn { margin:0; min-width:0; width:0; flex:1; }
.share-actions .btn-primary { flex:1.4; }
.share-error { margin-top:12px; font-size:13px; color:var(--danger); line-height:1.8; }
.share-error .text-button { margin:0; }
