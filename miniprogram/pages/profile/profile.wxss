@import "../../styles/profile-editor.wxss";
.page { padding: 0 16px 32px; }
.period-tabs { margin: 0 -16px; }
.section-title { font-size: 17px; font-weight: 500; margin-bottom: 12px; }
.note { font-size: 12px; color: var(--text-muted); line-height: 1.7; margin-top: 12px; }
.loading-state { padding: 32px 0; }
.loading-number { height: 56px; width: 60%; }
.error-note { padding: 16px 0; color: var(--danger); font-size: 14px; line-height: 1.7; }
.error-note .btn { width: 100%; margin-top: 16px; }
.usage-hero { padding: 24px 0; }
.hero-label { color: var(--text-secondary); font-size: 13px; }
.hero-number { font-size: 48px; font-weight: 400; line-height: 1.25; margin-top: 8px; color: var(--amount); overflow-wrap: anywhere; }
.hero-unit { font-size: 26px; font-weight: 400; margin-left: 6px; }
.exact { font-size: 13px; color: var(--text-secondary); margin-top: 8px; overflow-wrap: anywhere; }
.range { font-size: 12px; color: var(--text-muted); line-height: 1.7; margin-top: 8px; }
.usage-hero .share-button { width: 100%; margin: 20px 0 0; }
.metrics { display: flex; margin: 20px 0 0; padding: 16px 0 0; border-top: 1rpx solid var(--separator); }
.metric { flex: 1; min-width: 0; }
.metric-secondary { padding-left: 20px; border-left: 1rpx solid var(--separator); }
.metric-value { font-size: 22px; font-weight: 400; overflow-wrap: anywhere; }
.metric-unit { font-size: 13px; color: var(--text-secondary); font-weight: 400; }
.metric-label { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
.first-report { font-size: 14px; color: var(--text-secondary); margin-top: 16px; }
.first-report .btn { width: 100%; margin-top: 16px; }
.section { padding: 20px 0; border-top: 1rpx solid var(--separator); }
.section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.section-head .section-title { margin: 0; }
.section-head .text-button { margin: 0; flex: none; }
.section-meta { font-size: 12px; color: var(--text-muted); }
.chart-caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; color: var(--text-secondary); font-size: 12px; margin: 16px 0; }
.chart { height: 100px; display: flex; align-items: flex-end; border-bottom: 1rpx solid var(--separator-strong); }
.bar-slot { flex: 1; height: 100%; display: flex; align-items: flex-end; justify-content: center; padding: 0 5rpx; box-sizing: border-box; }
.bar { width: 100%; max-width: 22px; background: var(--amount); opacity: .35; min-height: 2rpx; border-radius: 2px 2px 0 0; }
.bar-zero { background: var(--separator-strong); }
.bar-selected .bar { opacity: 1; }
.axis { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); padding-top: 6px; }
.breakdown-label { font-size: 13px; color: var(--text-muted); margin: 16px 0 12px; }
.model-label { margin-top: 24px; }
.detail-row { margin-top: 14px; }
.detail-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; align-items: baseline; }
.detail-name { min-width: 0; overflow-wrap: anywhere; font-size: 14px; }
.detail-number { font-size: 12px; color: var(--text-secondary); }
.track { height: 3px; background: var(--separator); margin-top: 6px; }
.fill { height: 100%; background: var(--amount); }
.tool-fill { background: var(--text-secondary); }
.text-button { display: flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 8px; padding: 0; background: transparent; color: var(--link); font-size: 14px; font-weight: 400; }
.text-button::after { border: none; }
.cache-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font-size: 13px; color: var(--text-secondary); margin-top: 14px; }
.account-section { padding: 20px 0; border-top: 1rpx solid var(--separator); }
.sync-text { font-size: 13px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 12px; }
.account-section .btn { width: 100%; }
.ranking-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.ranking-row .section-title { margin-bottom: 0; }
.menu-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; box-sizing: border-box; border-top: 1rpx solid var(--separator); font-size: 15px; }
.menu-arrow { color: var(--text-muted); font-size: 22px; }
.account-delete { color: var(--danger); }
.share-options { display: flex; gap: 16px; }
.share-options .text-button { margin: 0; padding: 4px 0; }
.tools-share { float: right; margin: 0; padding: 0 0 0 12px; min-height: 32px; font-size: 13px; }

.history-entries { display: flex; flex-wrap: wrap; gap: 0 16px; border-top: 1rpx solid var(--separator); }
.history-entries button { width: calc(50% - 8px); flex: none; display: flex; justify-content: space-between; align-items: center; padding: 0; margin: 0; min-height: 56px; background: transparent; font-size: 15px; font-weight: 400; }
.history-entries button::after { border: none; }
.history-entries text { color: var(--text-muted); font-size: 22px; }
