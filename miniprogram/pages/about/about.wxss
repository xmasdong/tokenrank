@import "../../styles/upstream.wxss";
.page { padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
.head { padding: 16px; color: var(--text-secondary); font-size: 13px; line-height: 1.7; }
.sec { margin: 0 16px; padding: 20px 0; border-bottom: 1rpx solid var(--separator); }
.sec-title { font-size: 17px; font-weight: 500; margin-bottom: 12px; }
.p { font-size: 14px; color: var(--text-secondary); line-height: 1.8; margin: 10px 0; }
.connect-first .btn, .sec .btn { width: 100%; margin-top: 16px; }
.cmd { display: block; padding: 12px; margin: 12px 0; border-radius: 6px; background: var(--surface-muted); color: var(--text); font-family: Menlo, Consolas, monospace; font-size: 12px; line-height: 1.8; word-break: break-all; user-select: text; -webkit-user-select: text; }
.cmd-label { margin: 16px 0 6px; font-size: 13px; color: var(--text-secondary); }
.note { font-size: 12px; color: var(--text-muted); line-height: 1.7; margin-top: 12px; }
.upstream-project { border: none; padding: 0; }
