.page { padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
.state, .notice { padding: 20px 16px; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
.error { color: var(--danger); }
.block { padding: 8px 16px 16px; border-bottom: 1rpx solid var(--separator); }
.block + .block { padding-top: 0; }
.label { font-size: 14px; color: var(--text-secondary); }
.block > .label { display: block; padding: 16px 0 10px; }
.presets { display: flex; flex-wrap: wrap; gap: 8px; }
.preset { width: auto !important; display: inline-block; margin: 0 !important; padding: 0 14px; height: 36px; line-height: 36px; font-size: 14px; font-weight: 400; color: var(--text); background: var(--surface-muted); border-radius: 18px; }
.preset::after { border: none; }
.hint { margin-top: 10px; font-size: 12px; color: var(--text-muted); }
.field { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; border-bottom: 1rpx solid var(--separator); }
.field:last-child { border-bottom: none; }
.field .label { flex: none; width: 72px; }
.field input { flex: 1; text-align: right; font-size: 16px; }
.value { font-size: 16px; }
.seg { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; padding: 8px 0; }
.seg button { width: auto !important; display: inline-block; margin: 0 !important; padding: 0 12px; height: 32px; line-height: 32px; font-size: 13px; font-weight: 400; color: var(--text-secondary); background: var(--surface-muted); border-radius: 16px; }
.seg button::after { border: none; }
.seg button.on { color: #FFFFFF; background: var(--primary); }
.actions { padding: 24px 16px 0; }
.actions .btn { width: 100% !important; margin: 0; }
.text-button { width: auto !important; display: block; margin: 12px auto 0; min-height: 44px; padding: 10px 0; line-height: 24px; font-size: 14px; color: var(--link); background: transparent; }
.text-button::after { border: none; }
.remove { color: var(--danger); }
.footnote { padding: 18px 16px 0; color: var(--text-muted); font-size: 12px; line-height: 1.8; }
