page { background: var(--surface-muted); }
.page { padding: 12px 12px calc(96px + env(safe-area-inset-bottom)); }
.num { font-variant-numeric: tabular-nums; }
.state, .notice { padding: 20px 4px; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
.error { color: var(--danger); }
.group-label { padding: 6px 4px 10px; font-size: 14px; font-weight: 500; color: var(--text-secondary); }
.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.tpl { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 12px 2px 10px; border-radius: 12px; background: var(--surface); border: 1.5px solid transparent; }
.tpl.on { border-color: var(--primary); }
.tpl-icon { width: 36px; height: 36px; border-radius: 8px; }
.tpl-name { max-width: 100%; font-size: 11px; color: var(--text); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.hint { padding: 10px 4px 16px; font-size: 12px; color: var(--text-muted); }
.card { background: var(--surface); border-radius: 16px; padding: 4px 16px; margin-bottom: 12px; }
.name-row { display: flex; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1rpx solid var(--separator); }
.icon { flex: none; width: 44px; height: 44px; border-radius: 10px; }
.icon.ph { background: var(--surface-muted); color: var(--text-secondary); font-size: 18px; display: flex; align-items: center; justify-content: center; }
.name { flex: 1; font-size: 18px; font-weight: 500; }
.price-row { display: flex; align-items: center; gap: 8px; padding: 14px 0; border-bottom: 1rpx solid var(--separator); }
.currency { display: flex; align-items: center; gap: 4px; padding: 0 12px; height: 40px; line-height: 40px; font-size: 20px; font-weight: 500; color: var(--text); background: var(--surface-muted); border-radius: 8px; }
.caret { font-size: 11px; color: var(--text-muted); }
.price { flex: 1; height: 40px; font-size: 26px; font-weight: 600; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 52px; border-bottom: 1rpx solid var(--separator); }
.label { font-size: 14px; color: var(--text-secondary); }
.row-input { flex: 1; text-align: right; font-size: 15px; }
.row-value { font-size: 15px; }
.block { padding: 14px 0; border-bottom: 1rpx solid var(--separator); }
.pills { display: flex; gap: 6px; margin-top: 10px; padding: 3px; border-radius: 10px; background: var(--surface-muted); }
.pill { flex: 1; text-align: center; padding: 7px 0; font-size: 13px; color: var(--text-secondary); border-radius: 8px; }
.pill.on { color: var(--text); font-weight: 500; background: var(--surface); box-shadow: 0 1px 3px rgba(0,0,0,.08); }
.days { margin-top: 10px; height: 40px; padding: 0 12px; border-radius: 8px; background: var(--surface-muted); font-size: 15px; }
.card > picker:last-child .row, .card > .block:last-child { border-bottom: none; }
.notes { width: 100%; min-height: 60px; padding: 14px 0; font-size: 15px; line-height: 1.6; }
.text-button { width: auto !important; display: block; margin: 4px auto 0; min-height: 44px; padding: 10px 0; line-height: 24px; font-size: 14px; background: transparent; }
.text-button::after { border: none; }
.remove { color: var(--danger); }
.footnote { padding: 8px 4px 0; color: var(--text-muted); font-size: 12px; line-height: 1.8; text-align: center; }
.bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--separator); z-index: 5; }
.save { width: 100% !important; margin: 0 !important; }
.bar.two { display: flex; gap: 10px; }
.bar.two .save, .bar.two .next { flex: 1; width: auto !important; margin: 0 !important; }
.mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 10; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 11; background: var(--surface); border-radius: 20px 20px 0 0; padding: 16px 20px calc(16px + env(safe-area-inset-bottom)); }
.sheet-head { display: flex; align-items: center; gap: 10px; padding-bottom: 12px; border-bottom: 1rpx solid var(--separator); font-size: 18px; font-weight: 500; }
.sheet-icon { width: 36px; height: 36px; border-radius: 8px; }
.plan { display: flex; justify-content: space-between; align-items: center; min-height: 54px; font-size: 15px; border-bottom: 1rpx solid var(--separator); }
.plan:last-child { border-bottom: none; }
.plan-price { font-weight: 600; }
.sheet-scroll { max-height: 60vh; }
