<view class="page">
  <view wx:if="{{loading}}" class="state">正在读取使用记录…</view>
  <view wx:elif="{{error}}" class="state">{{error}}<button class="btn btn-ghost" bindtap="load">重试</button></view>
  <block wx:elif="{{report}}">
    <view class="month-nav"><button data-month="{{report.previous_month}}" bindtap="switchMonth" disabled="{{!report.previous_month}}">上月</button><text>{{report.heatmap.extended ? '截至 ' : ''}}{{report.title}}</text><button data-month="{{report.next_month}}" bindtap="switchMonth" disabled="{{!report.next_month}}">下月</button></view>
    <view class="data-share-actions"><button class="display-entry" bindtap="toggleDisplayOptions">{{customizing ? '完成' : '显示内容'}}</button><button open-type="share">转发小程序</button><button bindtap="shareInsightImage" loading="{{insightImageBusy}}" disabled="{{insightImageBusy}}">分享日历图片</button></view>
    <view wx:if="{{customizing}}" class="display-settings"><view class="display-settings-title">概览与分享图</view><checkbox-group bindchange="changeDisplay" class="display-options"><label wx:for="{{displayOptions}}" wx:key="key" class="display-option"><checkbox value="{{item.key}}" checked="{{item.checked}}" color="#07C160" /><view><view class="display-option-label">{{item.label}}</view><view class="display-option-note">{{item.note}}</view></view></label></checkbox-group><view class="display-option-note">用于日历概览与分享图。日期详情显示当天用量与估算金额。</view></view>
    <view class="month-summary"><view class="summary-label">{{report.heatmap.periodLabel}}{{display.tokens ? '已同步用量 · 含缓存' : '使用记录'}}</view><block wx:if="{{display.tokens}}"><view class="amount">{{report.heatmap.amount ? report.heatmap.amount.value : '—'}}<text>{{report.heatmap.amount ? report.heatmap.amount.unit : ''}}</text></view><view class="exact">{{report.heatmap.amount ? report.heatmap.exact + ' tokens' : '本区间暂无同步记录'}}</view></block><view class="counts"><text>{{report.heatmap.summary.active_days}} 天活跃</text><text>已同步 {{report.heatmap.summary.reported_days}} 天</text></view>
      <view wx:if="{{(display.device || display.model || display.cost) && !report.heatmap.detailView.supported}}" class="details-unavailable">暂无详细统计</view>
      <view wx:if="{{(display.device || display.model || display.cost) && report.heatmap.detailView.supported}}" class="calendar-details">
        <view wx:if="{{display.device}}" class="calendar-detail"><text class="calendar-detail-label">当前统计设备</text><text class="calendar-detail-value">{{report.heatmap.detailView.device}}</text></view>
        <view wx:if="{{display.model}}" class="calendar-detail"><text class="calendar-detail-label">最常用模型</text><text class="calendar-detail-value">{{report.heatmap.detailView.model}}</text></view>
        <block wx:if="{{display.cost}}"><view class="calendar-detail"><text class="calendar-detail-label">预计费用</text><text class="calendar-detail-value {{report.heatmap.detailView.costAvailable ? 'cost-value' : ''}}">{{report.heatmap.detailView.cost}}</text></view><view class="calendar-cost-note">{{report.heatmap.detailView.costNote}}</view></block>
      </view>
    </view>
    <view class="heatmap">
      <view class="heatmap-range">{{report.heatmap.rangeText}}</view>
      <block wx:if="{{report.heatmap.extended}}">
        <view class="heatmap-months"><view wx:for="{{report.heatmap.weeks}}" wx:key="key" class="heatmap-month">{{item.label}}</view></view>
        <view class="heatmap-body"><view class="heatmap-weekdays"><text wx:for="{{report.heatmap.rows}}" wx:key="index" class="heatmap-weekday">{{item}}</text></view><view class="heatmap-columns"><view wx:for="{{report.heatmap.weeks}}" wx:key="key" wx:for-item="week" class="heatmap-week"><view wx:for="{{week.days}}" wx:key="day" class="heatmap-cell {{item.state}} level-{{item.level}} {{selected.day === item.day ? 'selected' : ''}}" data-day="{{item.day}}" bindtap="selectDay" role="button" aria-disabled="{{item.outside || item.future}}" aria-label="{{item.day + '，' + item.statusText + (display.tokens && item.reported ? '，' + item.exact + ' tokens' : '')}}"></view></view></view></view>
      </block>
      <view wx:else class="month-grid">
        <view class="month-weekdays"><text wx:for="{{report.heatmap.weekdays}}" wx:key="index" class="month-weekday">{{item}}</text></view>
        <view wx:for="{{report.heatmap.weeks}}" wx:key="key" wx:for-item="week" class="month-row">
          <view wx:for="{{week.days}}" wx:key="day" class="month-slot"><view class="month-cell {{item.state}} level-{{item.level}} {{selected.day === item.day ? 'selected' : ''}}" data-day="{{item.day}}" bindtap="selectDay" role="button" aria-disabled="{{item.outside || item.future}}" aria-label="{{item.outside ? '' : item.day + '，' + item.statusText + (display.tokens && item.reported ? '，' + item.exact + ' tokens' : '')}}"><text wx:if="{{!item.outside}}" class="month-number">{{item.number}}</text></view></view>
        </view>
      </view>
    </view>
    <view class="legend"><view><text class="key missing"></text>未同步</view><view><text class="key zero"></text>零用量</view><view class="scale">少<text class="key level-1"></text><text class="key level-2"></text><text class="key level-3"></text><text class="key level-4"></text>多</view></view>
    <view wx:if="{{selected}}" class="day-detail">
      <view class="date-stepper"><button class="date-step {{canPrevious ? '' : 'date-step-disabled'}}" data-delta="-1" bindtap="stepDay" disabled="{{!canPrevious}}" aria-label="前一天">‹</button><picker class="date-picker" mode="date" value="{{selected.day}}" start="{{report.heatmap.from}}" end="{{report.heatmap.to}}" bindchange="pickDate"><view class="date-picker-label">{{selected.day}}<text class="date-picker-hint">选择日期</text></view></picker><button class="date-step {{canNext ? '' : 'date-step-disabled'}}" data-delta="1" bindtap="stepDay" disabled="{{!canNext}}" aria-label="后一天">›</button></view>
      <view class="day-status">{{selected.statusText}}</view>
      <view class="day-metrics">
        <view class="day-metric"><view class="day-metric-label">当日用量 · 含缓存</view><view class="day-amount">{{dayView.amount ? dayView.amount.value : '—'}}<text wx:if="{{dayView.amount.unit}}">{{dayView.amount.unit}}</text></view><view wx:if="{{dayView.reported}}" class="exact">{{dayView.exact}} tokens</view></view>
        <view class="day-metric {{dayView.wideCost ? 'day-metric-wide' : ''}}"><view class="day-metric-label">预计费用 · USD</view><view class="day-cost {{dayView.costAvailable ? 'cost-value' : ''}}">{{dayCostBusy ? '—' : dayView.cost}}</view><view wx:if="{{dayCostBusy}}" class="day-cost-state">读取估算中…</view><view wx:elif="{{dayCostError}}" class="day-cost-state">{{dayCostError}}<button class="day-retry" bindtap="retryDayDetails">重试</button></view><view wx:elif="{{dayView.costStatus}}" class="day-cost-state">{{dayView.costStatus}}</view></view>
      </view>
      <view wx:if="{{dayView.reported && dayView.costNote}}" class="calendar-cost-note">{{dayView.costNote}}</view>
      <view wx:if="{{!dayView.reported}}" class="note">这个日期没有同步记录。</view>
      <view wx:if="{{selected.reported && display.model && selected.detailView.supported}}" class="calendar-details"><view class="calendar-detail"><text class="calendar-detail-label">当日最常用模型</text><text class="calendar-detail-value">{{selected.detailView.model}}</text></view></view>
      <view class="day-links"><button wx:if="{{selected.day < report.today}}" class="text-button" bindtap="goDaily">查看当日日报</button><button class="text-button" bindtap="goWeekly">查看该周周报</button></view>
    </view>
    <view class="footnote">北京时间自然日，{{report.heatmap.extended ? '每列一周' : '每行一周'}}。点格子查看当日记录，也可直接选择日期。未同步与零用量分别展示，绿色深浅按本区间已同步用量分级。<text wx:if="{{report.first_day}}">已同步记录始于 {{report.first_day}}。</text></view>
    <button wx:if="{{!report.first_day}}" class="btn btn-ghost connect" bindtap="goConnect">查看电脑接入</button>
  </block>
</view>
<canvas type="2d" id="insightCanvas" class="export-canvas"></canvas>
