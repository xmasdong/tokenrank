<view class="page">
  <view wx:if="{{loading}}" class="state">正在读取使用记录…</view>
  <view wx:elif="{{error}}" class="state">{{error}}<button class="btn btn-ghost" bindtap="load">重试</button></view>
  <block wx:elif="{{report}}">
    <view class="month-nav"><button data-month="{{report.previous_month}}" bindtap="switchMonth" disabled="{{!report.previous_month}}">上月</button><text>{{report.title}}</text><button data-month="{{report.next_month}}" bindtap="switchMonth" disabled="{{!report.next_month}}">下月</button></view>
    <view class="month-summary"><view class="summary-label">本月已同步用量 · 含缓存</view><view class="amount">{{report.amount ? report.amount.value : '—'}}<text>{{report.amount ? report.amount.unit : ''}}</text></view><view class="exact">{{report.amount ? report.exact + ' tokens' : '本月暂无同步记录'}}</view><view class="counts"><text>{{report.summary.active_days}} 天活跃</text><text>已同步 {{report.summary.reported_days}} / {{report.summary.elapsed_days}} 天</text></view></view>
    <view class="weekdays"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
    <view class="calendar-grid"><view wx:for="{{report.cells}}" wx:key="key" class="day-slot"><button wx:if="{{!item.padding}}" class="day-button {{item.state}} level-{{item.level}} {{selected.day === item.day ? 'selected' : ''}}" data-day="{{item.day}}" bindtap="selectDay" disabled="{{item.future}}" aria-label="{{item.day + '，' + item.statusText + (item.reported ? '，' + item.exact + ' tokens' : '')}}"><text>{{item.number}}</text><text class="day-mark">{{item.state === 'missing' ? '—' : item.state === 'zero' ? '0' : ''}}</text></button></view></view>
    <view class="legend"><view><text class="key missing"></text>未同步</view><view><text class="key zero"></text>零用量</view><view class="scale">少<text class="key level-1"></text><text class="key level-2"></text><text class="key level-3"></text><text class="key level-4"></text>多</view></view>
    <view wx:if="{{selected}}" class="day-detail"><view class="day-heading"><text>{{selected.day}}</text><text>{{selected.statusText}}</text></view><view class="day-amount">{{selected.amount ? selected.amount.value : '—'}}<text>{{selected.amount ? selected.amount.unit : ''}}</text></view><view wx:if="{{selected.reported}}" class="exact">{{selected.exact}} tokens · {{selected.requestsText}} 次调用</view><view wx:else class="note">这个日期没有同步记录。</view><button class="text-button" bindtap="goWeekly">查看该周周报</button></view>
    <view class="footnote">北京时间自然日。未同步与零用量分别展示，颜色深浅按本月已同步用量计算。<text wx:if="{{report.first_day}}">已同步记录始于 {{report.first_day}}。</text></view>
    <button wx:if="{{!report.first_day}}" class="btn btn-ghost connect" bindtap="goConnect">查看电脑接入</button>
  </block>
</view>
