.page{padding:40rpx 32rpx calc(200rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:20rpx;letter-spacing:2rpx;color:var(--gold)}.person{display:flex;gap:20rpx;align-items:center;margin:40rpx 0}.avatar{width:88rpx;height:88rpx;flex:none;border-radius:50%}.initial{background:var(--seal);color:var(--paper);line-height:88rpx;text-align:center;font-size:36rpx}.name{font-size:32rpx;font-weight:600}.muted{font-size:23rpx;color:var(--ink-fade);margin-top:10rpx}.total{padding:32rpx;background:var(--seal);color:#FFF4E3;font-size:25rpx}.number{font-size:110rpx;line-height:1.5;font-weight:700;overflow-wrap:anywhere}.number-unit{font-size:42rpx;margin-left:16rpx}.exact{font-size:24rpx;letter-spacing:2rpx}.metrics{display:flex;gap:16rpx;padding:34rpx 0;border-bottom:1rpx solid var(--hairline)}.metric{flex:1 1 0%;width:0;min-width:0;overflow-wrap:anywhere}.metric-label,.metric-note{font-size:21rpx;color:var(--ink-fade);line-height:1.7}.metric-value{font-size:42rpx;font-weight:600;margin:12rpx 0;overflow-wrap:anywhere}.metric-unit{font-size:23rpx}.partner{padding:24rpx 0}.partner-name{font-size:32rpx;font-weight:600;margin-top:16rpx;overflow-wrap:anywhere}.partner-percent{float:right;color:var(--seal);font-size:26rpx;margin-left:12rpx}.note{font-size:22rpx;color:var(--ink-fade);line-height:1.8;margin-top:22rpx}.state{font-size:27rpx;padding:60rpx 0;line-height:1.8}.state .btn{margin-top:24rpx}

.person-details{min-width:0}.name,.exact{overflow-wrap:anywhere}

.bottom-action{position:fixed;left:0;right:0;bottom:0;z-index:10;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--paper);border-top:1rpx solid var(--hairline)}.bottom-action .btn{width:100%;margin:0}
.group-invite{margin-top:36rpx;padding-top:28rpx;border-top:1rpx solid var(--hairline)}.group-title{font-size:30rpx;font-weight:600}.group-invite .btn{width:100%;min-height:48px;box-sizing:border-box;margin:24rpx 0 0;padding:18rpx 24rpx;line-height:1.5}
