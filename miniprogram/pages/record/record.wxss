@import "../../styles/comparison.wxss";
@import "../../styles/weekly.wxss";
.page { padding: 0 16px calc(112px + env(safe-area-inset-bottom)); }
.person { display: flex; gap: 12px; align-items: center; padding: 20px 0; }
.avatar { width: 44px; height: 44px; flex: none; border-radius: 50%; }
.initial { background: var(--separator); color: var(--text-muted); line-height: 44px; text-align: center; font-size: 18px; }
.person-details { min-width: 0; }
.name { font-size: 17px; font-weight: 400; overflow-wrap: anywhere; }
.muted { font-size: 12px; color: var(--text-secondary); line-height: 1.7; margin-top: 6px; }
.total { padding: 20px 0; border-top: 1rpx solid var(--separator); border-bottom: 1rpx solid var(--separator); font-size: 14px; }
.number { font-size: 48px; line-height: 1.4; font-weight: 400; color: var(--amount); overflow-wrap: anywhere; }
.number-unit { font-size: 26px; margin-left: 6px; }
.exact { font-size: 13px; color: var(--text-secondary); overflow-wrap: anywhere; }
.metrics { display: flex; gap: 12px; padding: 20px 0; border-bottom: 1rpx solid var(--separator); }
.metric { flex: 1 1 0%; width: 0; min-width: 0; overflow-wrap: anywhere; }
.metric-label, .metric-note { font-size: 11px; color: var(--text-secondary); line-height: 1.7; }
.metric-value { font-size: 22px; font-weight: 400; margin: 6px 0; }
.metric-unit { font-size: 12px; }
.partner { padding: 16px 0; border-bottom: 1rpx solid var(--separator); }
.partner-name { font-size: 17px; font-weight: 400; margin-top: 8px; overflow-wrap: anywhere; }
.partner-percent { float: right; margin-left: 12px; color: var(--amount); font-size: 14px; }
.note { font-size: 12px; color: var(--text-secondary); line-height: 1.8; margin-top: 16px; }
.state { font-size: 14px; color: var(--text-secondary); padding: 32px 0; line-height: 1.8; }
.state .btn { width: 100%; margin-top: 16px; }
.bottom-action { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; gap: 12px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--separator); }
.bottom-action .btn { flex: 1; min-width: 0; width: 0; margin: 0; padding-left: 8px; padding-right: 8px; font-size: 14px; }
.group-invite { margin-top: 20px; padding-top: 16px; border-top: 1rpx solid var(--separator); }
.group-title { font-size: 17px; font-weight: 500; }
.group-invite .btn { width: 100%; margin-top: 16px; }
.receipt { padding: 20px 0; border-top: 1rpx solid var(--separator); border-bottom: 1rpx solid var(--separator); }
.receipt-title { font-size: 20px; font-weight: 500; }
.receipt-amount { font-size: 40px; font-weight: 400; margin: 16px 0 8px; color: var(--amount); overflow-wrap: anywhere; }
.receipt-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 12px 0; font-size: 14px; border-bottom: 1rpx solid var(--separator); }
.receipt-row text:first-child { min-width: 0; overflow-wrap: anywhere; }
.receipt-row text:last-child { flex: none; }
.receipt-heading { margin-top: 16px; color: var(--text-secondary); }
.shared-group { padding: 20px 0 0; }
.connect-entry { margin-top: 24px; padding-top: 16px; border-top: 1rpx solid var(--separator); font-size: 13px; color: var(--text-secondary); }
.connect-entry .btn { width: 100%; margin-top: 12px; }
.tool-row { padding-top: 16px; }
.tool-head { display: flex; justify-content: space-between; gap: 16px; font-size: 14px; line-height: 1.5; }
.tool-head text:first-child { min-width: 0; overflow-wrap: anywhere; }
.tool-head text:last-child { flex: none; color: var(--amount); }
.tool-track { height: 4px; margin-top: 10px; background: var(--surface-muted); }
.tool-fill { height: 4px; background: var(--amount); }
