<import src="../../templates/comparison.wxml" />
<import src="../../templates/weekly.wxml" />
<view class="page">
  <view wx:if="{{loading}}" class="state">正在加载用量…</view>
  <view wx:elif="{{error}}" class="state"><view>{{error}}</view><button class="btn btn-ghost" bindtap="load">重试</button></view>
  <block wx:else>
    <block wx:if="{{dailyReport}}">
      <view class="person"><image wx:if="{{record.user.avatar_url && !avatarFailed}}" class="avatar" src="{{record.user.avatar_url}}" mode="aspectFill" binderror="avatarError" /><view wx:else class="avatar initial">{{initial}}</view><view class="person-details"><view class="name">{{record.user.nickname}}</view><view class="muted">{{dailyReport.dateText}} · 用量日报</view></view></view>
      <view class="total"><view>Token 总量 · 含缓存</view><view class="number">{{dailyReport.value}}<text class="number-unit">{{dailyReport.unit}}</text></view><view class="exact">{{dailyReport.exact}} Tokens</view></view>
      <view class="receipt-row"><text>调用次数</text><text>{{dailyReport.requestsText}} 次</text></view>
      <view class="receipt-row"><text>主力工具</text><text>{{dailyReport.topTool}}</text></view><view class="receipt-row"><text>主力模型</text><text>{{dailyReport.topModel}}</text></view>
      <view class="receipt-row"><text>输入（不含缓存）</text><text>{{dailyReport.inputText}}</text></view><view class="receipt-row"><text>输出</text><text>{{dailyReport.outputText}}</text></view>
      <view class="receipt-row"><text>缓存读取</text><text>{{dailyReport.cacheReadText}}</text></view><view class="receipt-row"><text>缓存写入</text><text>{{dailyReport.cacheWriteText}}</text></view>
      <view class="note">{{dailyReport.day}} · 北京时间 · 分享时的记录</view>
    </block>
    <block wx:elif="{{weeklyReport}}"><template is="weekly-summary" data="{{weeklyReport, weeklyUser: record.user, initial, avatarFailed}}" /><view class="note">{{weeklyReport.from}} — {{weeklyReport.to}} · 北京时间 · 含缓存总量。数据为分享时的记录。群排名按分享时的当前成员计算。</view></block>
    <template wx:elif="{{comparison}}" is="comparison" data="{{comparison}}" />
    <block wx:else>
    <view class="person"><image wx:if="{{record.user.avatar_url && !avatarFailed}}" class="avatar" src="{{record.user.avatar_url}}" mode="aspectFill" binderror="avatarError" /><view wx:else class="avatar initial">{{initial}}</view><view class="person-details"><view class="name">{{record.user.nickname}}</view><view class="muted">截至 {{record.usage.to}}</view></view></view>
    
    <view wx:if="{{record.style === 'receipt'}}" class="receipt">
      <view class="receipt-title display">AI 用量账单</view><view class="muted">{{record.usage.from}} — {{record.usage.to}}</view>
      <view class="receipt-amount num-font">{{cost.available ? '$' + cost.amount : '—'}}</view>
      <view class="muted">API 等值估算 · USD · 非实际扣费</view><view wx:if="{{cost.note}}" class="muted">{{cost.note}}</view>
      <view class="receipt-row receipt-heading"><text>模型</text><text>USD</text></view>
      <view wx:for="{{cost.models}}" wx:key="name" class="receipt-row"><text>{{item.name}}</text><text class="num-font">${{item.amount}}</text></view>
      <view class="receipt-row"><text>总用量</text><text class="num-font">{{exact}} tokens</text></view>
      <view class="muted">生成于 {{issuedAt}} · 北京时间</view>
    </view>
    <view wx:else class="total"><view>{{story.label}}用量</view><view class="number num-font">{{story.value}}<text class="number-unit">{{story.unit}}</text></view><view class="exact num-font">{{exact}} tokens</view></view>
    <view wx:if="{{group}}" class="shared-group"><view class="group-title">{{group.name}}</view><view class="muted">{{group.members}} 人已加入 · {{group.participants}} 人上榜</view></view>
    <view class="metrics"><view class="metric"><view class="metric-label">{{group ? '群内排名' : '全站排名'}}</view><view class="metric-value">{{group ? groupRank : story.rankText}}</view><view class="metric-note">{{group ? '全站 ' + story.rankText : story.rankNote}}</view></view><view class="metric"><view class="metric-label">{{story.streakLabel}}</view><view class="metric-value">{{story.streakValue}}<text class="metric-unit"> 天</text></view><view class="metric-note">{{story.streakNote}}</view></view><view class="metric"><view class="metric-label">累计活跃</view><view class="metric-value">{{story.days}}<text class="metric-unit"> 天</text></view><view class="metric-note">{{story.firstDay ? '自 ' + story.firstDay + ' 起' : '暂无活跃记录'}}</view></view></view>
    <view wx:if="{{record.style === 'tools'}}" class="partner"><view class="muted">工具偏好 · 按 Token 占比</view><view wx:for="{{tools}}" wx:key="name" class="tool-row"><view class="tool-head"><text>{{item.name}}</text><text>{{item.percent}}%</text></view><view class="tool-track"><view class="tool-fill" style="width:{{item.percent}}%;"></view></view></view><view wx:if="{{!tools.length}}" class="muted">暂无工具明细</view></view>
    <view wx:else class="partner"><view class="muted">最常用工具</view><view class="partner-name">{{story.top.name || '暂无工具明细'}}<text class="partner-percent" wx:if="{{story.top}}">{{story.top.percent}}%</text></view></view>
    <view class="note"><view>{{record.usage.from}} — {{record.usage.to}} · {{story.timezoneLabel}}自然日</view><view>{{story.basisLabel}}。数据为分享时的记录。</view></view>
    </block>
    <view wx:if="{{fromGroup}}" class="group-invite"><view class="group-title">本群排名</view><button class="btn btn-ghost" bindtap="goGroup">查看本群排名</button></view>
    <view class="connect-entry"><text>电脑用量同步</text><button class="btn btn-ghost" bindtap="goConnect">接入电脑</button></view>
  </block>
</view>

<view class="bottom-action"><button class="btn {{record ? 'btn-ghost' : 'btn-primary'}}" bindtap="goMine" loading="{{openingMine}}" disabled="{{openingMine}}">去看我的用量</button><button wx:if="{{record}}" class="btn btn-primary" bindtap="goCompare">{{comparison ? '参与对比' : '和 TA 比一下'}}</button></view>
<canvas type="2d" id="socialCanvas" class="export-canvas"></canvas>
