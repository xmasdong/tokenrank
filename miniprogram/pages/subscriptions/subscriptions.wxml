<view class="page">
  <view wx:if="{{loading}}" class="state">正在读取订阅…</view>
  <block wx:elif="{{view}}">
    <view wx:if="{{view.empty}}" class="card empty">
      <view class="empty-title">记下你为 AI 付的钱</view>
      <view class="description">记下 Claude、ChatGPT、Cursor 等订阅，算出每天花多少；再和电脑端统计的 Token 用量对照，看每天有没有用回本。</view>
      <button class="btn btn-primary wide" bindtap="add">添加订阅</button>
    </view>
    <view wx:if="{{view.suggestions.length}}" class="card suggest">
      <view class="card-label">根据近 7 天的用量，你可能在用</view>
      <view wx:for="{{view.suggestions}}" wx:key="key" class="sg" data-key="{{item.key}}" data-topup="{{item.topup}}" bindtap="addSuggested">
        <image class="icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="body"><view class="title">{{item.name}}</view><view class="meta">{{item.hint || '近 7 天 ' + item.tokens + ' · ' + item.evidence}}</view><view wx:if="{{item.hint}}" class="meta">近 7 天 {{item.tokens}} · {{item.evidence}}</view></view>
        <view class="sg-add">{{item.action}}</view>
      </view>
    </view>
    <block wx:if="{{!view.empty}}">
      <view class="unit-bar"><text>金额单位</text><picker range="{{currencyLabels}}" value="{{currencyIndex}}" bindchange="pickDisplay"><view class="unit-pick">{{view.displayLabel}}<text class="caret">▾</text></view></picker></view>
      <view wx:if="{{view.today}}" class="card today">
        <view class="card-label">今天 Token 值多少钱</view>
        <view class="today-row">
          <view><text class="big num">{{view.today.value}}</text></view>
          <view wx:if="{{view.today.paid === true}}" class="badge paid">已回本 {{view.today.ratio}} 倍</view>
          <view wx:elif="{{view.today.paid === false}}" class="badge unpaid">还差 {{view.today.gap}}</view>
        </view>
        <view class="today-note">{{view.today.daily ? '订阅每天 ' + view.today.daily + ' · ' : ''}}按上报的模型价格估算</view>
        <view wx:if="{{view.week.judged}}" class="week">
          <view wx:for="{{view.week.cells}}" wx:key="day" class="cell {{item.state}}"><text class="cell-label">{{item.label}}</text><text class="cell-value num">{{item.value}}</text></view>
        </view>
        <view wx:if="{{view.week.judged}}" class="week-note">近 7 天回本 {{view.week.paidDays}} 天<text class="legend paid-dot"></text>回本<text class="legend unpaid-dot"></text>未回本</view>
      </view>
      <view class="card">
        <view class="card-label">订阅每日成本</view>
        <view wx:if="{{view.total}}" class="total">
          <view class="daily"><text class="mid num">{{view.total.daily}}</text><text class="per">/天</text><text class="count">{{view.total.count}} 个订阅中</text></view>
          <view class="mini"><view><text class="mini-label">月均</text><text class="num">{{view.total.monthly}}</text></view><view><text class="mini-label">年均</text><text class="num">{{view.total.yearly}}</text></view><view><text class="mini-label">累计已花</text><text class="num">{{view.total.spent}}</text></view></view>
        </view>
        <view wx:if="{{view.value}}" class="value">近 30 天 API 等值 <text class="num">{{view.value.api}}</text>，是订阅月费 <text class="num">{{view.value.plan}}</text> 的 <text class="ratio num">{{view.value.ratio}} 倍</text></view>
      </view>
      <view wx:if="{{view.active.length}}" class="section">订阅中 <text>{{view.active.length}}</text></view>
      <view wx:for="{{view.active}}" wx:key="id" class="tile" bindtap="edit" data-id="{{item.id}}">
        <image wx:if="{{item.icon}}" class="icon" src="{{item.icon}}" mode="aspectFit" /><view wx:else class="icon ph">{{item.initial}}</view>
        <view class="body"><view class="title">{{item.title}}</view><view class="meta">{{item.meta}}</view>
          <view wx:if="{{item.period}}" class="today-tag {{item.period.paid ? 'paid' : 'unpaid'}}">{{item.period.text}} · {{item.period.left}}{{item.today && item.today.shared ? ' · ' + item.today.shared : ''}}</view>
          <view wx:elif="{{item.apiKey}}" class="today-tag">走 API Key 付费，不计入回本</view>
          <view wx:if="{{item.period && item.period.note}}" class="today-small">{{item.period.note}}</view>
          <view wx:if="{{item.today}}" class="today-small">今天 {{item.today.value}}</view>
        </view>
        <view class="cost"><view class="num">{{item.daily}}</view><view class="unit">每天</view></view>
      </view>
      <view wx:if="{{view.topups.length}}" class="section">按量充值</view>
      <view wx:for="{{view.topups}}" wx:key="vendor" class="card topup">
        <view class="tp-head"><image class="icon" src="{{item.icon}}" mode="aspectFit" /><text class="title">{{item.name}}</text><text class="tp-label">估算余额</text></view>
        <view class="tp-remain"><text class="big2 num {{item.low ? 'warn' : ''}}">{{item.remaining}}</text><text wx:if="{{item.low}}" class="tp-low">可能已用完，请校准</text><text wx:else class="tp-days">{{item.daysLeft}}</text></view>
        <view class="bar-track"><view class="bar-fill" style="width: {{item.percent}}%"></view></view>
        <view class="tp-meta">累计充值 {{item.total}}（{{item.count}} 次）· 估算已用 {{item.spent}} · 已用 {{item.percent}}%</view>
        <view class="tp-meta">近 7 天日均 {{item.avg}} · 今天约 {{item.today}} · {{item.basis}}</view>
        <view class="tp-actions"><button class="tp-btn" data-vendor="{{item.vendor}}" data-kind="topup" bindtap="addTopup">记一笔充值</button><button class="tp-btn ghost" data-vendor="{{item.vendor}}" data-kind="balance" bindtap="addTopup">校准余额</button></view>
        <view class="tp-records"><view wx:for="{{item.records}}" wx:for-item="r" wx:key="id" class="tp-record" data-id="{{r.id}}" bindtap="editTopup"><text>{{r.day}} {{r.label}}</text><text class="num">{{r.amount}}</text></view></view>
      </view>
      <view wx:if="{{view.inactive.length}}" class="section">已停用 <text>{{view.inactive.length}}</text></view>
      <view wx:for="{{view.inactive}}" wx:key="id" class="tile dim" bindtap="edit" data-id="{{item.id}}">
        <image wx:if="{{item.icon}}" class="icon" src="{{item.icon}}" mode="aspectFit" /><view wx:else class="icon ph">{{item.initial}}</view>
        <view class="body"><view class="title">{{item.title}}</view><view class="meta">{{item.meta}}</view></view>
        <view class="cost"><view class="num">{{item.spent}}</view><view class="unit">累计</view></view>
      </view>
      <view wx:if="{{view.fx}}" class="footnote">按 {{view.fx}} 换算。</view>
      <view class="footnote">每天成本 = 每期价格 ÷ 周期天数，月均按 30.44 天、年均按 365 天换算，累计按开始日起已扣的期数计算。每个订阅按本期累计判断：从本期开始到今天，该厂商模型的 API 等值估算与这一期价格比较；顶部卡片是今天的价值与全部订阅每天成本的对照。按量充值（DeepSeek）是实际花费，不计入订阅回本；标记走 API Key 的订阅只算成本。Claude、ChatGPT、Gemini、Kimi、智谱的订阅另按该厂商模型单独判断，同一厂商的多个订阅合并计算。估算不代表实际账单。订阅只有你自己能看到，不进入排名和分享。</view>
    </block>
  </block>
  <view wx:if="{{error}}" class="notice error" role="alert">{{error}}<button class="btn btn-ghost" bindtap="load">重试</button></view>
  <button wx:if="{{view && !view.empty}}" class="fab" bindtap="add" aria-label="添加订阅">+</button>
</view>
<privacy-notice />
