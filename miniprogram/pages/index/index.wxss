.page { padding-bottom: 200rpx; }

/* ── 报头 ── */
.masthead { display: flex; align-items: center; gap: 24rpx; padding: 44rpx 32rpx 28rpx; }
.seal-lg { width: 72rpx; height: 72rpx; font-size: 40rpx; border-radius: 8rpx; }
.mast-title { font-size: 44rpx; font-weight: 900; letter-spacing: 2rpx; }
.mast-sub { font-size: 24rpx; color: var(--ink-fade); margin-top: 6rpx; letter-spacing: 2rpx; }
.mast-about {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink-soft);
  border: 1rpx solid var(--hairline-strong);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  letter-spacing: 2rpx;
}

.profile-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 32rpx 0;
  padding: 20rpx 26rpx;
  font-size: 25rpx;
  color: var(--ink-soft);
  background: rgba(156, 124, 44, 0.09);
  border: 1rpx solid rgba(156, 124, 44, 0.28);
  border-radius: 10rpx;
}
.profile-tip .arr { color: var(--gold); font-weight: 600; flex: none; margin-left: 20rpx; }


/* ── 榜单行 ── */
.row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.row-first { background: rgba(156, 124, 44, 0.05); }
.row .seal { flex: none; }
.rk-plain {
  flex: none;
  width: 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--ink-fade);
  font-weight: 600;
}
.mid { flex: 1; min-width: 0; }
.name { font-size: 30rpx; font-weight: 600; }
.sub { font-size: 23rpx; color: var(--ink-fade); margin-top: 6rpx; letter-spacing: 0.5rpx; }
.num { text-align: right; flex: none; }
.num .n { font-size: 36rpx; font-weight: 700; }
.num-gold .n { color: var(--gold); }
.num .unit { font-size: 20rpx; color: var(--ink-fade); margin-top: 2rpx; letter-spacing: 1rpx; }

/* ── 骨架 ── */
.sk-rank { width: 48rpx; height: 48rpx; flex: none; }
.sk-name { width: 200rpx; height: 30rpx; margin-bottom: 14rpx; }
.sk-sub { width: 280rpx; height: 22rpx; }
.sk-num { width: 160rpx; height: 40rpx; flex: none; }

/* ── 空态 / 错误 ── */
.hint { padding: 110rpx 60rpx; text-align: center; }
.hint-title { font-size: 40rpx; font-weight: 700; letter-spacing: 6rpx; text-indent: 6rpx; }
.hint-sub { font-size: 26rpx; color: var(--ink-fade); line-height: 1.8; margin-top: 20rpx; }
.hint-link { display: inline-block; margin-top: 32rpx; color: var(--seal); font-size: 28rpx; border-bottom: 1rpx solid var(--seal); padding-bottom: 4rpx; }

/* ── 操作 ── */
.actions { display: flex; flex-direction: column; gap: 20rpx; padding: 44rpx 32rpx 8rpx; }
.hint .btn, .actions .btn { width: 100%; min-height: 48px; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.5; }
.legal { text-align: center; font-size: 21rpx; color: #B5AD98; letter-spacing: 2rpx; text-indent: 2rpx; margin-top: 36rpx; }

/* ── 我的位次底栏 ── */
.me-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--ink);
  color: var(--paper);
  padding: 22rpx 32rpx;
}
.me-left { display: flex; align-items: baseline; gap: 16rpx; }
.me-label { font-size: 24rpx; opacity: 0.72; letter-spacing: 2rpx; }
.me-rank { font-size: 38rpx; font-weight: 700; color: var(--gold-bright); }
.me-num { font-size: 34rpx; font-weight: 700; }
.me-unit { font-size: 20rpx; opacity: 0.6; font-weight: 400; }

/* ── 我的群排名 ── */
.mg-sec { margin-top: 8rpx; }
.mg-sec-title { font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; padding: 24rpx 32rpx 12rpx; }
.mg-card { margin: 0 32rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--hairline); }
.mg-top { display: flex; justify-content: space-between; align-items: baseline; }
.mg-name { font-size: 29rpx; font-weight: 600; }
.mg-upd { font-size: 21rpx; color: #B5AD98; }
.mg-meta { display: flex; align-items: baseline; gap: 12rpx; margin-top: 10rpx; font-size: 24rpx; color: var(--ink-fade); }
.mg-num { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.mg-num.num-gold { color: var(--gold); }
.mg-sep { color: var(--hairline-strong); }
.mg-members { margin-left: auto; font-size: 21rpx; color: #B5AD98; }

.upd-line { display: flex; justify-content: space-between; font-size: 21rpx; color: #B5AD98; padding: 16rpx 32rpx 4rpx; }

/* ── 接入状态条 ── */
.conn-strip { margin: 0 32rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--hairline); }
.strip-arr { margin-left: auto; color: var(--seal); }

.retry { margin-top: 28rpx; }
.mg-name { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.mg-upd { flex: none; margin-left: 16rpx; }
.name, .sub { overflow-wrap: anywhere; }
.own-usage { margin: 0 32rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--hairline); }
.own-head, .own-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; }
.own-head { font-size: 30rpx; font-weight: 600; }.own-link { color: var(--seal); font-size: 24rpx; font-weight: 400; flex: none; padding: 8rpx 0; }
.own-number { font-size: 76rpx; font-weight: 700; line-height: 1.3; margin: 12rpx 0 4rpx; }.own-unit, .own-tokens { font-size: 30rpx; margin-left: 8rpx; }.own-number .own-tokens { font-size: 24rpx; font-weight: 400; color: var(--ink-fade); }
.own-meta, .own-note { font-size: 24rpx; color: var(--ink-fade); line-height: 1.7; }.own-note { margin-top: 14rpx; }
.own-meta { align-items: center; }
.own-meta .own-share { display: flex; align-items: center; flex: none; width: auto; min-height: 44px; box-sizing: border-box; margin: 0; padding: 0; background: transparent; color: var(--seal); border: none; border-radius: 0; font-size: 26rpx; line-height: 1.4; }
.own-share::after { border: none; }
.own-head .own-entry { width: auto; min-height: 44px; margin: 0; padding: 8rpx 0; background: transparent; line-height: 1.5; display: flex; align-items: center; border-radius: 0; }
.own-entry::after { border: none; }
.own-usage .quick-start { width: 100%; min-height: 48px; margin: 20rpx 0 0; padding: 20rpx 24rpx; box-sizing: border-box; font-size: 28rpx; line-height: 1.5; }
.mg-name { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

/* 续页：广场榜（群榜在自身样式中定义同款） */
.pagination { margin: 24rpx 32rpx 0; text-align: center; }
.pagination .load-more { width: 100%; min-height: 44px; margin: 0; padding: 16rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid var(--hairline); border-radius: 6rpx; background: transparent; color: var(--ink-soft); font-size: 25rpx; font-weight: 400; line-height: 1.5; }
.load-more::after { border: none; }
.pagination-end, .pagination-error { font-size: 22rpx; color: var(--ink-fade); line-height: 1.7; }
.pagination-error { margin-bottom: 12rpx; color: var(--seal); }
