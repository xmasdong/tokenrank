.page { padding-bottom: 32px; }
.home-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 16px; color: var(--text-muted); font-size: 13px; }
.home-toolbar .mast-about { display: flex; align-items: center; min-height: 44px; width: auto; margin: 0; padding: 0 0 0 16px; background: transparent; color: var(--link); font-size: 14px; font-weight: 400; border-radius: 0; }
.mast-about::after { border: none; }
.own-usage { margin: 0 16px; padding: 20px 0 16px; border-bottom: 1rpx solid var(--separator); }
.own-head, .own-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.own-head { font-size: 16px; font-weight: 500; }
.own-link { flex: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0; color: var(--link); font-size: 14px; font-weight: 400; }
.own-number { color: var(--amount); font-size: 40px; font-weight: 400; line-height: 1.3; margin: 4px 0 8px; overflow-wrap: anywhere; }
.own-unit { font-size: 24px; margin-left: 6px; }
.own-tokens { font-size: 13px; color: var(--text-muted); margin-left: 6px; }
.own-meta, .own-note { color: var(--text-secondary); font-size: 13px; line-height: 1.7; }
.own-note { margin-top: 12px; }
.own-meta .own-share, .own-head .own-entry { display: flex; align-items: center; flex: none; width: auto; min-height: 44px; margin: 0; padding: 0; background: transparent; color: var(--link); font-size: 14px; font-weight: 400; line-height: 1.5; border: none; border-radius: 0; }
.own-share::after, .own-entry::after { border: none; }
.quick-start { width: 100%; margin: 16px 0 0; }
.conn-strip { margin: 0 16px; padding: 10px 0; min-height: 44px; box-sizing: border-box; border-bottom: 1rpx solid var(--separator); }
.strip-arr { margin-left: auto; color: var(--link); }
.profile-tip { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; background: var(--surface-muted); color: var(--text-secondary); font-size: 13px; }
.profile-tip .arr { color: var(--link); flex: none; }
.mg-sec { margin-top: 16px; }
.mg-sec-title { display: flex; align-items: center; justify-content: space-between; padding: 8px 16px; color: var(--text-muted); background: var(--surface-muted); font-size: 13px; }
.mg-card { min-height: 80px; box-sizing: border-box; padding: 16px; border-bottom: 1rpx solid var(--separator); }
.mg-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.mg-name { flex: 1; min-width: 0; font-size: 16px; font-weight: 400; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mg-upd { flex: none; color: var(--text-muted); font-size: 11px; }
.mg-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin-top: 8px; color: var(--text-secondary); font-size: 13px; }
.mg-num { font-size: 16px; font-weight: 400; color: var(--text); }
.mg-tokens { color: var(--amount); font-size: 16px; }
.mg-unit { margin-left: 3px; color: var(--text-muted); font-size: 11px; }
.mg-members { margin-left: auto; font-size: 12px; color: var(--text-muted); }
.hint { padding: 36px 24px; text-align: center; }
.hint-title { font-size: 18px; font-weight: 500; }
.hint-sub { color: var(--text-secondary); font-size: 14px; line-height: 1.8; margin-top: 12px; }
.hint-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 12px; color: var(--link); font-size: 14px; }
.hint .btn { width: 100%; margin-top: 20px; }
.actions { padding: 24px 16px 0; }
.actions .btn { width: 100%; }
.legal { text-align: center; color: var(--text-muted); font-size: 11px; margin-top: 24px; }
