<view class="page">
  <view class="home-toolbar"><text>每个群一张榜</text><button class="mast-about" bindtap="goAbout">使用说明</button></view>
  <view class="tabs"><view wx:for="{{periods}}" wx:key="key" class="tab {{period === item.key ? 'tab-active' : ''}}" data-key="{{item.key}}" bindtap="switchPeriod">{{item.label}}</view></view>
  <view class="conn-strip status-line status-{{connState}}" wx:if="{{user}}" aria-role="button" bindtap="goConnect" aria-label="{{hasReported ? '查看电脑同步状态' : '接入电脑'}}">
    <view class="status-dot"></view><text>{{connText}}</text><text class="strip-arr">{{hasReported ? '同步设置' : '接入电脑'}}</text>
  </view>
  <view wx:if="{{loading}}" class="hint">正在加载我的群榜…</view>
  <view wx:elif="{{error}}" class="hint"><view class="hint-sub">{{error}}</view><button class="btn btn-ghost retry" bindtap="load">重新加载</button></view>
  <view wx:elif="{{!myGroups.length}}" class="hint">
    <view class="hint-title display">还没有加入群榜</view>
    <view class="hint-sub">把卡片发到微信群，从群里点开后加入。</view>
    <button class="btn btn-primary retry" open-type="share">分享到微信群</button>
    <view class="hint-link" bindtap="goSquare">看广场榜</view>
  </view>
  <block wx:else>
    <view class="mg-sec">
      <view class="mg-sec-title"><text>已加入群榜</text><text>{{myGroups.length}} 个</text></view>
      <view class="mg-card" wx:for="{{myGroups}}" wx:key="id" bindtap="openGroup" data-id="{{item.id}}">
        <view class="mg-top"><text class="mg-name">{{item.name}}</text><text class="mg-upd">{{item.updated_fmt}}</text></view>
        <view class="mg-meta"><text>群内 <text class="mg-num num-font">{{item.my_rank_label}}</text></text><text class="mg-tokens num-font">{{item.tokens_fmt}}<text class="mg-unit">tokens</text></text><text class="mg-members">{{item.members}} 人已加入</text></view>
      </view>
    </view>
    <view class="actions"><button class="btn btn-primary" open-type="share">分享到其他群</button></view>
  </block>
  <view class="legal">数据由用户电脑上报，仅供参考</view>
</view>
<privacy-notice />
