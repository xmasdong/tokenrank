<view class="page">
  <view class="masthead">
    <view class="seal seal-lg display">群</view>
    <view class="mast-text"><view class="mast-title display">我的群榜</view><view class="mast-sub">每个群一张榜</view></view>
    <view class="mast-about" bindtap="goAbout">说明</view>
  </view>
  <view class="double-rule"></view>
  <view class="tabs"><view wx:for="{{periods}}" wx:key="key" class="tab {{period === item.key ? 'tab-active' : ''}}" data-key="{{item.key}}" bindtap="switchPeriod">{{item.label}}</view></view>
  <view class="own-usage">
    <view class="own-head"><text class="display">我的用量</text><button wx:if="{{!hasReported && (usageLoading || usageError || (usage && usage.has_history))}}" class="own-link own-entry" bindtap="goConnect">接入电脑</button><text wx:elif="{{hasReported}}" class="own-link" bindtap="goProfile">详情</text></view>
    <view wx:if="{{usageLoading}}" class="own-note">正在读取用量…</view>
    <view wx:elif="{{usageError}}" class="own-note">用量加载失败：{{usageError}}<text class="own-link" bindtap="load"> 重试</text></view>
    <block wx:elif="{{usage && !usage.has_history && !hasReported}}">
      <view class="own-note">在电脑上运行接入命令后显示用量。不想上榜也行，接入后可以关掉排名。</view>
      <button class="btn btn-seal quick-start" bindtap="goConnect">接入电脑</button>
    </block>
    <block wx:elif="{{usage}}">
      <view class="own-number num-font" bindtap="goProfile">{{usage.value}}<text class="own-unit">{{usage.unit}}</text><text class="own-tokens"> tokens</text></view>
      <view class="own-meta"><text>{{usage.periodLabel}} · {{usage.requestsText}} 次调用</text><button class="own-share" wx:if="{{usage.has_history}}" bindtap="goShare">分享</button></view>
    </block>
  </view>
  <view class="conn-strip status-line status-{{connState}}" wx:if="{{user && hasReported}}" bindtap="goConnect">
    <text class="status-dot"></text><text>{{connText}}</text><text class="strip-arr">查看</text>
  </view>
  <view class="profile-tip" wx:if="{{user && hasReported && !user.nickname}}" bindtap="goProfile">
    <text>还没设置昵称</text><text class="arr">设置</text>
  </view>
  <view wx:if="{{loading}}" class="hint">正在加载我的群榜…</view>
  <view wx:elif="{{error}}" class="hint"><view class="hint-sub">{{error}}</view><button class="btn btn-ghost retry" bindtap="load">重新加载</button></view>
  <view wx:elif="{{!myGroups.length}}" class="hint">
    <view class="hint-title display">还没有加入群榜</view>
    <view class="hint-sub">把卡片发到微信群，从群里点开后加入。</view>
    <button class="btn btn-seal retry" open-type="share">分享到微信群</button>
    <view class="hint-link" bindtap="goSquare">看广场榜</view>
  </view>
  <block wx:else>
    <view class="mg-sec">
      <view class="mg-card" wx:for="{{myGroups}}" wx:key="id" bindtap="openGroup" data-id="{{item.id}}">
        <view class="mg-top"><text class="mg-name">{{item.name}}</text><text class="mg-upd">{{item.updated_fmt}}</text></view>
        <view class="mg-meta"><text>群内 <text class="mg-num num-font">{{item.my_rank_label}}</text></text><text>{{item.tokens_fmt}} tokens</text><text class="mg-members">{{item.members}} 人</text></view>
      </view>
    </view>
    <view class="actions"><button class="btn btn-seal" open-type="share">分享到其他群</button></view>
  </block>
  <view class="legal">数据由用户电脑上报，仅供参考</view>
</view>
<privacy-notice />
