@import "../../styles/profile-editor.wxss";
.page { padding-bottom: calc(176rpx + env(safe-area-inset-bottom)); }

/* 群身份与同步入口 */
.hero { padding: 40rpx 32rpx 24rpx; }
.hero-top { display: flex; align-items: center; gap: 20rpx; }
.seal-lg { flex: none; width: 64rpx; height: 64rpx; font-size: 36rpx; }
.hero-text { flex: 1; min-width: 0; }
.hero-name { font-size: 40rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.hero-sub { font-size: 24rpx; color: var(--ink-fade); margin-top: 4rpx; }
.hero-top .rename-btn { flex: none; width: auto; min-height: 30px; margin: 0; padding: 6rpx 22rpx; display: flex; align-items: center; box-sizing: border-box; background: transparent; color: var(--ink-soft); border: 1rpx solid var(--hairline-strong); font-size: 24rpx; font-weight: 400; line-height: 1.5; border-radius: 999rpx; }
.rename-btn::after, .sync-strip::after, .text-action::after { border: none; }
.hero .sync-strip { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; min-height: 44px; margin: 24rpx 0 0; padding: 16rpx 20rpx; box-sizing: border-box; border: none; border-radius: 6rpx; background: var(--paper-lift); color: var(--ink-soft); font-size: 24rpx; font-weight: 400; line-height: 1.6; text-align: left; }
.sync-main { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.sync-text { min-width: 0; overflow-wrap: anywhere; }
.sync-action { flex: none; color: var(--seal); }
.quick-connect { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; }
.quick-copy { flex: 1; min-width: 0; }
.quick-title { font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.quick-note { font-size: 23rpx; color: var(--ink-fade); line-height: 1.6; margin-top: 4rpx; }
.quick-connect .quick-connect-btn { flex: none; width: auto; margin: 0; min-height: 48px; box-sizing: border-box; padding: 16rpx 24rpx; font-size: 26rpx; line-height: 1.5; letter-spacing: 0; display: flex; align-items: center; }
.connection-panel { margin-top: 24rpx; }
.hero-tip { font-size: 26rpx; color: var(--ink-fade); line-height: 1.8; }
.hero-cta { margin-top: 32rpx; }
.hero-share { margin-top: 16rpx; }
.hint .btn, .connection-panel .btn { width: 100%; min-height: 48px; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.5; }

/* 周期和榜单 */
.board-count { display: flex; justify-content: space-between; padding: 20rpx 32rpx 4rpx; color: var(--ink-fade); font-size: 22rpx; }
.pagination { margin: 24rpx 32rpx 0; text-align: center; }
.pagination .load-more { width: 100%; min-height: 44px; margin: 0; padding: 16rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid var(--hairline); border-radius: 6rpx; background: transparent; color: var(--ink-soft); font-size: 25rpx; font-weight: 400; line-height: 1.5; }
.load-more::after { border: none; }
.pagination-end, .pagination-error { font-size: 22rpx; color: var(--ink-fade); line-height: 1.7; }
.pagination-error { margin-bottom: 12rpx; color: var(--seal); }
.row { display: flex; align-items: center; gap: 16rpx; padding: 28rpx 32rpx; border-bottom: 1rpx solid var(--hairline); }
.row-first { background: rgba(156,124,44,.04); }
.row .seal { flex: none; width: 44rpx; height: 44rpx; font-size: 26rpx; }
.rk-plain { flex: none; width: 44rpx; text-align: center; font-size: 28rpx; color: var(--ink-fade); }
.row .rank-avatar { width: 56rpx; height: 56rpx; }
.mid { flex: 1; min-width: 0; }
.name { font-size: 28rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.sub { font-size: 22rpx; color: var(--ink-fade); line-height: 1.6; margin-top: 4rpx; }
.model { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row-meta { display: flex; flex-wrap: wrap; column-gap: 16rpx; margin-top: 0; }
.num { text-align: right; flex: none; max-width: 36%; }
.n { font-size: 36rpx; font-weight: 700; line-height: 1.3; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.num-gold .n { color: var(--gold); }
.unit { font-size: 20rpx; color: var(--ink-fade); margin-top: 4rpx; }
.board-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx 20rpx; margin: 24rpx 32rpx 0; font-size: 22rpx; color: var(--ink-fade); line-height: 1.6; }
.board-tools { display: flex; align-items: center; gap: 24rpx; margin: 16rpx 32rpx 0; }
.board-tools .text-action { width: auto; min-height: 44px; display: flex; align-items: center; margin: 0; padding: 12rpx 0; box-sizing: border-box; background: transparent; color: var(--ink-soft); font-size: 24rpx; font-weight: 400; line-height: 1.5; text-align: left; border-radius: 0; }
.board-tools .other-groups { margin-left: auto; }
.share-note, .poster-note { margin: 8rpx 32rpx 0; color: var(--ink-fade); font-size: 22rpx; line-height: 1.7; }

/* 我的排名和分享始终可见，留足底部手势区。 */
.share-dock { position: fixed; z-index: 2; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--paper-lift); border-top: 1rpx solid var(--hairline); }
.dock-summary { min-width: 0; flex: 1; }
.dock-rank { font-size: 22rpx; color: var(--ink-soft); line-height: 1.5; }
.dock-rank-number { font-size: 26rpx; font-weight: 600; color: var(--ink); margin-left: 8rpx; }
.dock-value { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx; font-size: 30rpx; font-weight: 700; line-height: 1.5; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.dock-unit { font-size: 20rpx; font-weight: 400; color: var(--ink-fade); }
.dock-empty { font-size: 26rpx; line-height: 1.5; margin-top: 4rpx; }
.share-dock .dock-share { width: auto; min-height: 48px; flex: none; margin: 0; padding: 20rpx 28rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 27rpx; line-height: 1.5; letter-spacing: 0; }

/* 识别、确认和错误状态 */
.hint { padding: 80rpx 40rpx; text-align: center; }
.hint-sm { padding: 64rpx 40rpx; }
.hint-title { font-size: 38rpx; font-weight: 700; line-height: 1.5; }
.hint-sub { font-size: 26rpx; color: var(--ink-fade); line-height: 1.8; margin-top: 20rpx; }
.hint-link { display: inline-block; margin-top: 32rpx; padding: 12rpx 0; color: var(--seal); font-size: 26rpx; }
.join-prompt { text-align: left; padding: 64rpx 40rpx; }
.join-name { font-size: 30rpx; color: var(--ink); margin-top: 32rpx; overflow-wrap: anywhere; }
.poster-canvas { position: fixed; left: -9999px; top: 0; width: 375px; height: 575px; }

@media (max-width: 340px) {
  .hero-name { font-size: 36rpx; }
  .row { gap: 12rpx; }
  .share-dock { gap: 16rpx; }
  .share-dock .dock-share { padding-left: 20rpx; padding-right: 20rpx; }
}

.profile-gate { padding: 48rpx 32rpx; }
.profile-kicker { color: var(--ink-fade); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.profile-title { margin-top: 14rpx; font-size: 42rpx; font-weight: 700; line-height: 1.4; }
.profile-intro { margin: 20rpx 0 36rpx; color: var(--ink-soft); font-size: 27rpx; line-height: 1.7; }
.profile-gate .note { margin-top: 20rpx; color: var(--ink-fade); font-size: 23rpx; line-height: 1.7; }
.profile-gate .profile-exit { background: transparent; color: var(--ink-soft); width: auto; margin: 20rpx 0 0; padding: 12rpx 0; min-height: 44px; display: flex; align-items: center; font-size: 25rpx; font-weight: 400; border-radius: 0; }
.profile-exit::after { border: none; }

.source-note { margin: 0 0 20rpx; padding: 16rpx 20rpx; border-radius: 8rpx; background: rgba(156, 124, 44, 0.09); color: var(--ink-soft); font-size: 24rpx; line-height: 1.6; text-align: left; }

/* 群名最长 100 字：页面内最多两行 */
.hero-name, .join-name { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

/* 未起名提示与建榜起名输入 */
.name-prompt { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; padding: 16rpx 20rpx; border-radius: 6rpx; background: rgba(156, 124, 44, 0.09); color: var(--ink-soft); font-size: 24rpx; }
.name-prompt .name-prompt-btn { flex: none; width: auto; min-height: 30px; margin: 0; padding: 6rpx 24rpx; display: flex; align-items: center; background: var(--seal); color: var(--paper); font-size: 24rpx; font-weight: 600; line-height: 1.5; border-radius: 999rpx; }
.name-prompt-btn::after { border: none; }
.name-input { margin-top: 28rpx; height: 48px; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid var(--hairline-strong); border-radius: 8rpx; background: var(--paper-lift); font-size: 28rpx; }
.name-ph { color: var(--ink-fade); }

.visibility-row { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 32rpx 0; padding: 12rpx 0; font-size: 26rpx; color: var(--ink-soft); }
