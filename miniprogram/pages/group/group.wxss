@import "../../styles/profile-editor.wxss";
@import "../../styles/leaderboard.wxss";
.page { padding-bottom: calc(150px + env(safe-area-inset-bottom)); }

/* 群名、同步入口保持微信列表的普通字号。 */
.hero { padding: 12px 16px 0; }
.hero-top { display: flex; align-items: center; gap: 12px; }
.hero-text { flex: 1; min-width: 0; }
.hero-name { font-size: 17px; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.hero-sub { margin-top: 3px; color: var(--text-muted); font-size: 12px; line-height: 1.5; }
.hero-top .rename-btn { flex: none; width: auto; min-height: 44px; margin: 0; padding: 0 4px 0 12px; display: flex; align-items: center; box-sizing: border-box; background: transparent; color: var(--link); font-size: 14px; font-weight: 400; line-height: 1.5; border-radius: 0; }
.rename-btn::after, .sync-strip::after, .text-action::after { border: none; }
.hero .sync-strip { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: 44px; margin: 0; padding: 0; box-sizing: border-box; border: none; border-radius: 0; background: transparent; color: var(--text-muted); font-size: 12px; font-weight: 400; line-height: 1.5; text-align: left; }
.sync-main { display: flex; align-items: center; gap: 6px; min-width: 0; }
.sync-text { min-width: 0; overflow-wrap: anywhere; }
.sync-action { flex: none; color: var(--link); }
.status-dot { width: 5px; height: 5px; background: var(--primary); }
.status-pending .status-dot, .status-stale .status-dot { background: var(--danger); }
.quick-connect { display: flex; align-items: center; gap: 12px; padding: 12px 0; }
.quick-copy { flex: 1; min-width: 0; }
.quick-title { font-size: 14px; font-weight: 400; line-height: 1.5; }
.quick-note { margin-top: 3px; color: var(--text-muted); font-size: 12px; line-height: 1.5; }
.quick-connect .quick-connect-btn { flex: none; width: auto; margin: 0; min-height: 44px; box-sizing: border-box; padding: 8px 16px; font-size: 14px; line-height: 1.5; letter-spacing: 0; display: flex; align-items: center; }
.connection-panel { margin-top: 12px; }
.hero-tip { font-size: 14px; color: var(--text-muted); line-height: 1.8; }
.hero-cta { margin-top: 32rpx; }
.hero-share { margin-top: 16rpx; }
.hint .btn, .connection-panel .btn { width: 100%; min-height: 48px; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.5; }

/* 周期和榜单 */
.pagination { margin: 24rpx 32rpx 0; text-align: center; }
.pagination .load-more { width: 100%; min-height: 44px; margin: 0; padding: 16rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid var(--separator); border-radius: 6rpx; background: transparent; color: var(--text-secondary); font-size: 25rpx; font-weight: 400; line-height: 1.5; }
.load-more::after { border: none; }
.pagination-end, .pagination-error { font-size: 22rpx; color: var(--text-muted); line-height: 1.7; }
.pagination-error { margin-bottom: 12rpx; color: var(--danger); }
.board-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx 20rpx; margin: 24rpx 32rpx 0; font-size: 22rpx; color: var(--text-muted); line-height: 1.6; }
.board-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 24rpx; margin: 16rpx 32rpx 0; }
.poster-style-label { display: flex; align-items: center; min-height: 44px; color: var(--link); font-size: 13px; }
.board-tools .text-action { width: auto; min-height: 44px; display: flex; align-items: center; margin: 0; padding: 12rpx 0; box-sizing: border-box; background: transparent; color: var(--link); font-size: 14px; font-weight: 400; line-height: 1.5; text-align: left; border-radius: 0; }
.board-tools .other-groups { margin-left: auto; }
.share-note, .poster-note { margin: 8rpx 32rpx 0; color: var(--text-muted); font-size: 22rpx; line-height: 1.7; }

/* 同一行展示自己的名次、头像和用量，分享位于其下。 */
.dock-actions { padding: 0 16px 12px; }
.share-dock .dock-share { width: 100%; min-height: 44px; margin: 0; padding: 8px 16px; font-size: 15px; line-height: 1.5; }

/* 识别、确认和错误状态 */
.hint { padding: 80rpx 40rpx; text-align: center; }
.hint-sm { padding: 64rpx 40rpx; }
.hint-title { font-size: 38rpx; font-weight: 500; line-height: 1.5; }
.hint-sub { font-size: 26rpx; color: var(--text-muted); line-height: 1.8; margin-top: 20rpx; }
.hint-link { display: inline-block; margin-top: 32rpx; padding: 12rpx 0; color: var(--link); font-size: 26rpx; }
.join-prompt { text-align: left; padding: 64rpx 40rpx; }
.join-name { font-size: 30rpx; color: var(--text); margin-top: 32rpx; overflow-wrap: anywhere; }
.poster-canvas { position: fixed; left: -9999px; top: 0; width: 375px; height: 575px; }


.profile-gate { padding: 48rpx 32rpx; }
.profile-kicker { color: var(--text-muted); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.profile-title { margin-top: 14rpx; font-size: 42rpx; font-weight: 500; line-height: 1.4; }
.profile-intro { margin: 20rpx 0 36rpx; color: var(--text-secondary); font-size: 27rpx; line-height: 1.7; }
.profile-gate .note { margin-top: 20rpx; color: var(--text-muted); font-size: 23rpx; line-height: 1.7; }
.profile-gate .profile-exit { background: transparent; color: var(--text-secondary); width: auto; margin: 20rpx 0 0; padding: 12rpx 0; min-height: 44px; display: flex; align-items: center; font-size: 25rpx; font-weight: 400; border-radius: 0; }
.profile-exit::after { border: none; }

.source-note { margin: 0 0 20rpx; padding: 16rpx 20rpx; border-radius: 8rpx; background: var(--surface-muted); color: var(--text-secondary); font-size: 24rpx; line-height: 1.6; text-align: left; }

/* 群名最长 100 字：页面内最多两行 */
.hero-name, .join-name { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

/* 未起名提示与建榜起名输入 */
.name-prompt { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; padding: 16rpx 20rpx; border-radius: 6rpx; background: var(--surface-muted); color: var(--text-secondary); font-size: 24rpx; }
.name-prompt .name-prompt-btn { flex: none; width: auto; min-height: 44px; margin: 0; padding: 6rpx 24rpx; display: flex; align-items: center; background: var(--primary); color: #FFFFFF; font-size: 24rpx; font-weight: 500; line-height: 1.5; border-radius: 6px; }
.name-prompt-btn::after { border: none; }
.name-input { margin-top: 28rpx; height: 48px; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid var(--separator-strong); border-radius: 8rpx; background: var(--surface-muted); font-size: 28rpx; }
.name-ph { color: var(--text-muted); }

.visibility-row { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 32rpx 0; padding: 12rpx 0; font-size: 26rpx; color: var(--text-secondary); }
