@import "../../styles/comparison.wxss";
.page { padding: 0 16px calc(112px + env(safe-area-inset-bottom)); }
.state { padding: 32px 0; font-size: 14px; color: var(--text-secondary); line-height: 1.8; }
.source-name { font-size: 18px; color: var(--text); overflow-wrap: anywhere; }
.source-range { margin: 8px 0 24px; font-size: 12px; }
.state .btn { width: 100%; margin-top: 16px; }
.actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; gap: 12px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--separator); }
.actions .btn { flex: 1; min-width: 0; width: 0; margin: 0; }
.note, .image-error { margin: 16px 0; font-size: 12px; color: var(--text-secondary); line-height: 1.8; }
.revoke { color: var(--text-secondary); font-size: 12px; }
