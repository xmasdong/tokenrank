.page { padding: 38rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.page.has-actions { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.eyebrow { font-size: 19rpx; letter-spacing: 3rpx; color: var(--gold); }
.page-title { font-size: 48rpx; font-weight: 700; margin-top: 14rpx; letter-spacing: 2rpx; }
.subtitle { font-size: 25rpx; color: var(--ink-fade); margin-top: 14rpx; }
.theme-picker { display: flex; gap: 20rpx; margin: 32rpx 0 28rpx; }
.theme { margin: 0; background: transparent; display: flex; align-items: center; justify-content: center; gap: 12rpx; padding: 4rpx 26rpx; font-size: 25rpx; color: var(--ink-soft); border: 1rpx solid var(--hairline); border-radius: 6rpx; }.theme::after { border: none; }.theme.selected { border-color: var(--ink); color: var(--ink); }
.swatch { width: 22rpx; height: 22rpx; border-radius: 50%; border: 1rpx solid var(--hairline-strong); }.swatch.paper { background: #F7F4EC; }.swatch.receipt-paper { background: #FFFFFF; }.swatch.ink { background: #242923; }
.poster-frame { width: 100%; box-shadow: 0 12rpx 32rpx rgba(42,39,35,.10); line-height: 0; }.poster { width: 100%; display: block; }
.poster-placeholder { height: 962rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 26rpx; line-height: 1.7; color: var(--ink-fade); font-size: 24rpx; }.poster-placeholder .serif { font-size: 38rpx; }.ink .poster-placeholder { background: #242923; color: #C8AF70; }.ink .poster-placeholder .btn { color: #F4EFDF; }
.preview-note { text-align: center; font-size: 22rpx; color: var(--ink-fade); margin-top: 22rpx; }
.actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; gap: 18rpx; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--paper); border-top: 1rpx solid var(--hairline); }.actions .btn { display: flex; align-items: center; justify-content: center; flex: 1 1 0%; width: 0; min-width: 0; min-height: 48px; box-sizing: border-box; margin: 0; padding: 16rpx 12rpx; line-height: 1.4; font-size: 28rpx; }
.footnote { font-size: 22rpx; color: var(--ink-fade); line-height: 1.8; margin-top: 22rpx; }
.record-preview { background: transparent; font-size: 26rpx; color: var(--ink); margin-top: 20rpx; padding: 8rpx 20rpx; }.record-preview::after { border: none; }
.state { padding: 72rpx 16rpx; font-size: 27rpx; color: var(--ink-soft); line-height: 1.8; }.state .btn { margin-top: 28rpx; }
.empty-note { font-size: 24rpx; color: var(--ink-soft); margin-bottom: 24rpx; }.connect-link { color: var(--seal); }
.export-canvas { position: fixed; left: -2200px; top: 0; width: 1000px; height: 1400px; pointer-events: none; }

.revoke { background: transparent; font-size: 22rpx; color: var(--ink-fade); margin-top: 20rpx; }.revoke::after { border: none; }

.style-picker { margin-top: 28rpx; }
