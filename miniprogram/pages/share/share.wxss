.page { padding: 20px 16px calc(24px + env(safe-area-inset-bottom)); }
.page.has-actions { padding-bottom: calc(100px + env(safe-area-inset-bottom)); }
.page-title { font-size: 20px; font-weight: 500; }
.subtitle { font-size: 13px; color: var(--text-secondary); margin-top: 8px; }
.style-picker { margin: 16px -16px 0; }
.theme-picker { display: flex; gap: 12px; margin: 16px 0; }
.theme { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; width: auto; margin: 0; padding: 8px 16px; box-sizing: border-box; color: var(--text-secondary); background: #F2F2F2; border-radius: 6px; font-size: 14px; font-weight: 400; line-height: 1.5; }
.theme::after { border: none; }
.theme.selected { background: var(--surface-muted); color: var(--text); box-shadow: inset 0 0 0 1px var(--separator-strong); }
/* 色块仅描述导出图片的主题，页面本身始终白底。 */
.swatch { width: 12px; height: 12px; border: 1rpx solid var(--separator-strong); border-radius: 50%; }
.swatch.paper { background: #F7F4EC; }
.swatch.receipt-paper { background: #FFFFFF; }
.swatch.ink { background: #242923; }
.poster-frame { width: 100%; margin-top: 16px; border: 1rpx solid var(--separator); box-sizing: border-box; line-height: 0; }
.poster { width: 100%; display: block; }
.poster-placeholder { min-height: 400px; padding: 24px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; font-size: 13px; color: var(--text-secondary); line-height: 1.7; }
.poster-placeholder .display { font-size: 18px; }
.preview-note { text-align: center; color: var(--text-muted); font-size: 12px; margin-top: 12px; }
.actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; gap: 12px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--separator); background: var(--surface); }
.actions .btn { flex: 1 1 0%; min-width: 0; width: 0; margin: 0; font-size: 15px; }
.footnote { font-size: 12px; color: var(--text-secondary); line-height: 1.8; margin-top: 12px; }
.record-preview, .revoke { display: flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 12px; padding: 8px 12px; background: transparent; color: var(--link); border-radius: 0; font-size: 14px; font-weight: 400; line-height: 1.5; }
.record-preview::after, .revoke::after { border: none; }
.revoke { color: var(--text-secondary); font-size: 12px; }
.state { padding: 32px 0; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
.state .btn { width: 100%; margin-top: 16px; }
.empty-note { padding: 20px 0; color: var(--text-secondary); font-size: 14px; }
.connect-link { color: var(--link); }
.export-canvas { position: fixed; left: -2200px; top: 0; width: 1000px; height: 1400px; pointer-events: none; }
