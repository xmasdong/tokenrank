.achievement-page{padding:28rpx 24rpx 48rpx}.achievement-summary{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:28rpx}.earned-number{font-size:54rpx;color:#191919;font-weight:600}.earned-unit{font-size:25rpx;color:#777}.achievement-summary .note{font-size:21rpx;margin:0}
.connect-note{display:flex;align-items:center;justify-content:space-between;font-size:25rpx;color:#888;margin-bottom:20rpx}
.achievement-row{display:flex;margin-bottom:16rpx}.achievement-tile{width:33.3333%;background:transparent;border:0;padding:14rpx 0 22rpx;text-align:center;font-weight:400;box-sizing:border-box;border-radius:0;margin:0;border-bottom:3rpx solid transparent}.achievement-tile::after{border:0}.achievement-tile-selected{background:linear-gradient(#fff,#f3f7f1);border-bottom-color:#16854b}.achievement-thumb{display:block;width:176rpx;height:176rpx;margin:0 auto 14rpx}.achievement-label{font-size:25rpx;color:#333;line-height:1.5}.achievement-status{font-size:21rpx;line-height:1.5;color:#999;margin-top:6rpx}.achievement-locked{filter:grayscale(1);opacity:.38}
.future-toggle{display:flex;align-items:center;justify-content:space-between;gap:20rpx;box-sizing:border-box;min-height:88rpx;width:100%;font-size:24rpx;color:#7c897f;background:transparent;border-radius:0;padding:30rpx 0;margin-top:12rpx;border-top:1rpx solid #ededed;line-height:1.5}.future-action{flex-shrink:0;color:#576b95}.poster-section{margin-top:28rpx}.achievement-poster{display:block;width:100%}.motion-setting{display:flex;align-items:center;justify-content:space-between;font-size:26rpx;padding:30rpx 0;border-top:1rpx solid #ededed;margin-top:22rpx}.achievement-page .note{font-size:22rpx;line-height:1.8}

.achievement-page .text-button{display:flex;align-items:center;justify-content:center;width:auto;min-width:0;min-height:88rpx;margin:0;padding:12rpx 8rpx;line-height:1.5;font-size:24rpx;font-weight:400;color:#576b95;background:transparent}.achievement-page .text-button::after{border:0}

.achievement-card-page{padding:28rpx 28rpx calc(190rpx + env(safe-area-inset-bottom));background:#F3F5EF;min-height:100vh;box-sizing:border-box}.card-tiers{padding:26rpx 0 0}.tier-label{font-size:23rpx;color:#71806A;margin-bottom:16rpx}.tier-options{display:flex;flex-wrap:wrap;gap:12rpx}.tier-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:1 1 calc(50% - 12rpx);max-width:calc(50% - 6rpx);min-height:88rpx;padding:12rpx;margin:0;background:transparent;border:1rpx solid #D8E1D0;border-radius:8rpx;color:#788371;font-size:24rpx;font-weight:400;line-height:1.5}.tier-button::after{border:0}.tier-selected{background:#E4ECDd;border-color:#94AD86;color:#31552D}.card-note,.card-image-error{font-size:23rpx;color:#788371;line-height:1.7;margin-top:20rpx}.card-actions{position:fixed;left:0;right:0;bottom:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;gap:16rpx;background:#FFF;border-top:1rpx solid #E8EDE4;z-index:20}.card-actions .btn{flex:1;min-width:0;margin:0;font-size:28rpx;padding-left:12rpx;padding-right:12rpx}.card-actions .btn[disabled]{background:#F2F2F2;color:#A8ADA5}

.tier-pin{width:72rpx;height:72rpx;flex:none;margin-right:10rpx}.tier-pin-locked{filter:grayscale(1);opacity:.45}

.motion-toolbar{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-top:12rpx;font-size:23rpx;color:#71806A}.motion-toolbar .text-button{margin:0;padding:0 4rpx}.motion-toolbar .text-button[disabled]{color:#A5ADA0}
