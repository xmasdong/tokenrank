<template name="weekly-summary">
  <view class="weekly-person"><image wx:if="{{weeklyUser.avatar_url && !avatarFailed}}" src="{{weeklyUser.avatar_url}}" mode="aspectFill" binderror="avatarError" /><view wx:else class="weekly-avatar-ph">{{initial}}</view><view class="weekly-name">{{weeklyUser.nickname || '我'}}<view class="weekly-range">{{weeklyReport.from}} — {{weeklyReport.to}} · 北京时间</view></view></view>
  <view class="weekly-total"><view class="weekly-caption">{{weeklyReport.weekly.complete ? '个人周报' : '本周截至 ' + weeklyReport.throughLabel}} · 已同步用量</view><view class="weekly-amount">{{weeklyReport.amount ? weeklyReport.amount.value : '—'}}<text>{{weeklyReport.amount ? weeklyReport.amount.unit : ''}}</text></view><view class="weekly-exact">{{weeklyReport.amount ? weeklyReport.exact + ' tokens' : '本周暂无同步记录'}}</view></view>
  <view class="weekly-stats"><view><text>{{weeklyReport.summary.active_days}}</text><view>活跃天数</view></view><view><text>{{weeklyReport.requestsText}}</text><view>调用次数</view></view><view><text>{{weeklyReport.weekly.reported_days}} / 7</text><view>已同步天数</view></view></view>
  <view class="weekly-line"><view>较上周用量<view class="weekly-note">上周已同步 {{weeklyReport.weekly.previous_reported_days}} / 7 天</view></view><text>{{weeklyReport.changeText}}</text></view>
  <view class="weekly-line"><view>单日峰值<view class="weekly-note">{{weeklyReport.peak ? weeklyReport.peak.day : '暂无峰值记录'}}</view></view><text>{{weeklyReport.peak ? weeklyReport.peak.amount.value + ' ' + weeklyReport.peak.amount.unit : '—'}}</text></view>
  <view class="weekly-line"><text>最常用工具</text><view class="weekly-tool">{{weeklyReport.topTool ? weeklyReport.topTool.name : '暂无工具明细'}}<view wx:if="{{weeklyReport.topTool}}" class="weekly-note">{{weeklyReport.topTool.percent}}%</view></view></view>
  <view class="weekly-line"><text>最常用模型</text><view class="weekly-tool">{{weeklyReport.topModel ? weeklyReport.topModel.name : '暂无模型明细'}}<view wx:if="{{weeklyReport.topModel}}" class="weekly-note">{{weeklyReport.topModel.percent}}%</view></view></view>
  <view wx:if="{{weeklyReport.group}}" class="weekly-line"><view>{{weeklyReport.group.name}}<view class="weekly-note">本期 {{weeklyReport.group.participants}} 人上榜 · 当前成员</view></view><text>{{weeklyReport.group.hidden ? '未参与排名' : weeklyReport.group.rankText}}</text></view>
</template>
