.pn-layer { position: fixed; z-index: 1000; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; padding: 24px; box-sizing: border-box; }
.pn-mask { position: absolute; z-index: 0; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0, 0, 0, .5); }
.pn-card { position: relative; z-index: 1; display: flex; flex-direction: column; max-height: calc(100vh - 48px - env(safe-area-inset-bottom)); width: 100%; box-sizing: border-box; padding: 24px 20px 20px; border-radius: 12px; background: var(--surface, #FFFFFF); color: var(--text, #191919); }
.pn-heading { position: relative; min-height: 44px; padding-right: 44px; display: flex; align-items: center; gap: 12px; flex: none; margin-bottom: 12px; }
.pn-title { flex: 1; min-width: 0; font-size: 18px; font-weight: 500; }
.pn-close { position: absolute; right: -10px; top: 0; flex: none; width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; background: transparent; color: var(--text-secondary, #666666); font-size: 28px; line-height: 44px; }
.pn-close::after { border: 0; }
.pn-body { height: 52vh; min-height: 0; flex-shrink: 1; }
.pn-p { font-size: 14px; line-height: 1.8; color: var(--text, #191919); }
.pn-soft { margin-top: 12px; color: var(--text-secondary, #666666); font-size: 13px; }
.pn-repo { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 12px 0 4px; padding: 12px; border-radius: 6px; background: var(--surface-muted, #F7F7F7); }
.pn-url { flex: 1; min-width: 0; font-family: Menlo, Consolas, monospace; font-size: 12px; word-break: break-all; }
.pn-copy { flex: none; display: flex; align-items: center; min-height: 44px; color: var(--link, #576B95); font-size: 13px; font-weight: 400; }
.pn-actions { flex: none; display: flex; gap: 12px; margin-top: 20px; }
.pn-actions .pn-btn { flex: 1; width: auto; margin: 0; min-height: 44px; font-size: 14px; }

/* root-portal is outside page, so page-level CSS variables may be absent. */
.pn-actions .btn-primary { background: var(--primary, #07C160); color: #FFFFFF; }
.pn-actions .btn-primary:active { background: var(--primary-active, #06AD56); }
.pn-actions .btn-ghost { color: var(--text, #191919); }
