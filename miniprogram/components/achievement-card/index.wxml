<view class="medal-card {{badge.earned ? '' : 'medal-card-locked'}} {{playing ? 'medal-card-playing' : ''}}">
 <view class="card-top"><text>Token 群排名</text><text class="card-status">{{badge.earned ? '已达成' : badge ? '未达成' : '暂未开放'}}</text></view>
 <view class="medal-stage"><image class="medal-art" src="{{badge.artPath || family.artPath}}" mode="aspectFit" bindload="artReady" binderror="artError" /></view>
 <view class="card-category">{{badge.family === 'connect' ? '电脑接入' : family.label || badge.label}}</view>
 <view class="card-target">{{badge ? (badge.family === 'connect' ? '首次同步' : badge.targetText) : '暂未开放'}}</view>
 <view class="card-date">{{badge.earned ? '达成于 ' + badge.dateText : badge ? '还差 ' + badge.gapText : family.metric_label}}</view>
 <view wx:if="{{badge}}" class="card-record"><text class="record-label">{{badge.metric_label}}</text><text class="record-value">{{badge.metricText}}</text></view>
 <view wx:if="{{badge && !badge.earned}}" class="card-progress"><view class="card-progress-fill" style="width:{{badge.progress}}%;"></view></view>
 <view class="card-bottom"><view class="card-owner"><view class="owner-row"><image wx:if="{{user.avatar_url && !avatarFailed}}" class="owner-avatar" src="{{user.avatar_url}}" mode="aspectFill" binderror="avatarError" /><view wx:else class="owner-dot"></view><text class="owner-name">{{user.nickname || '我的成就'}}</text></view><view class="card-basis">{{badge.unit === 'Tokens' ? '含缓存总量 · ' : ''}}北京时间</view><view wx:if="{{shared}}" class="card-basis">分享时的记录</view></view><image wx:if="{{badge.earned}}" class="card-code" src="/assets/mini-program-code.jpg" mode="aspectFit" /></view>
</view>
