:host{display:block}.medal-card{box-sizing:border-box;padding:36rpx 36rpx 28rpx;background:#FAFBF5;border:1rpx solid #DBE3D5;border-radius:20rpx;color:#213D2B;overflow:hidden}.card-top{display:flex;justify-content:space-between;gap:16rpx;font-size:22rpx;color:#6A7C67;line-height:1.5}.card-status{color:#396848;flex:none}.medal-stage{display:flex;justify-content:center;align-items:center;padding:8rpx 0 0}.medal-art{display:block;width:350rpx;height:350rpx;max-width:100%}.card-category{text-align:center;font-size:24rpx;line-height:1.5;color:#63785E}.card-target{text-align:center;font-size:60rpx;line-height:1.35;font-weight:600;margin-top:8rpx;overflow-wrap:anywhere}.card-date{text-align:center;font-size:22rpx;line-height:1.6;margin-top:12rpx;color:#73836C}.card-record{display:flex;justify-content:space-between;align-items:baseline;gap:16rpx;border-top:1rpx solid #DCE4D5;margin-top:32rpx;padding-top:26rpx;font-size:23rpx;line-height:1.6}.record-label{color:#6A7C67;min-width:0}.record-value{font-size:29rpx;color:#BD7931;text-align:right;flex:none}.card-bottom{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding-top:26rpx}.card-owner{min-width:0}.owner-row{display:flex;align-items:center;gap:12rpx;margin-bottom:10rpx;min-width:0}.owner-avatar{width:44rpx;height:44rpx;border-radius:50%;flex:none}.owner-dot{width:10rpx;height:10rpx;background:#527A4D;border-radius:50%;flex:none}.owner-name{font-size:24rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.5}.card-basis{font-size:19rpx;line-height:1.7;color:#7B8974}.card-code{width:120rpx;height:120rpx;box-sizing:border-box;border-radius:50%;padding:6rpx;background:#FFF;flex:none}.medal-card-locked .medal-art{filter:grayscale(1);opacity:.4}.medal-card-locked .card-status{color:#8A9186}.medal-card-locked .card-target{color:#65715F}.card-progress{height:6rpx;background:#E3E8DC;margin-top:12rpx}.card-progress-fill{height:100%;background:#70966B}
.medal-stage{position:relative;overflow:hidden}
.medal-motion{width:350rpx;max-width:100%;transform-origin:50% 50%}
.medal-sweep{position:absolute;left:-20%;top:-20%;right:-20%;bottom:-20%;opacity:0;pointer-events:none;background:linear-gradient(115deg,transparent 37%,rgba(255,247,220,.45) 45%,transparent 53%)}
@media(prefers-reduced-motion:reduce){.medal-motion{transform:none!important;opacity:1!important}.medal-sweep{opacity:0!important}}
