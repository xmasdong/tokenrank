/* 微信运动式列表，共用全局界面令牌。 */
.lb-table-head { display: flex; justify-content: space-between; padding: 8px 16px; background: var(--surface-muted); color: var(--text-muted); font-size: 12px; line-height: 1.5; }
.lb-row, .lb-self { display: flex; align-items: center; gap: 12px; }
.lb-row { min-height: 72px; padding: 16px; box-sizing: border-box; border-bottom: 1rpx solid var(--separator); }
.lb-row-me { background: var(--surface-muted); }
.lb-rank { flex: 0 0 24px; text-align: center; font-size: 15px; font-weight: 400; line-height: 1.5; color: var(--text-secondary); }
.lb-avatar { flex: none; width: 40px; height: 40px; border-radius: 50%; }
.lb-row .lb-avatar-action { flex: none; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin: -2px; padding: 0; border: 0; border-radius: 50%; background: transparent; line-height: 1; }
.lb-avatar-action::after { border: none; }
.lb-avatar-pressed { opacity: .6; }
.lb-avatar.rank-avatar-ph { background: var(--separator); color: var(--text-muted); font-size: 16px; font-weight: 400; }
.lb-person { flex: 1; min-width: 0; text-align: left; }
.lb-name-line { display: flex; align-items: center; gap: 6px; }
.lb-name { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 16px; font-weight: 400; line-height: 1.5; }
.lb-model { margin-top: 2px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--text-muted); font-size: 12px; font-weight: 400; line-height: 1.4; }
.lb-me-tag { flex: none; color: var(--text-muted); font-size: 11px; font-weight: 400; }
.lb-value { display: flex; flex: none; align-items: baseline; justify-content: flex-end; gap: 4px; text-align: right; color: var(--amount); line-height: 1.4; font-variant-numeric: tabular-nums; }
.lb-number { white-space: nowrap; font-size: 24px; font-weight: 400; }
.lb-unit { white-space: nowrap; font-size: 16px; font-weight: 400; }

/* 本人固定行沿用列表排列；名次不受已加载人数限制。 */
.lb-own-dock { position: fixed; z-index: 2; left: 0; right: 0; bottom: 0; background: var(--surface-muted); border-top: 1rpx solid var(--separator); padding-bottom: env(safe-area-inset-bottom); }
.lb-own-dock .lb-self { width: 100%; min-height: 72px; margin: 0; padding: 14px 16px; box-sizing: border-box; background: transparent; border-radius: 0; color: var(--text); font-weight: 400; line-height: 1.5; }
.lb-self::after { border: none; }
.lb-self-note { margin-top: 2px; color: var(--text-muted); font-size: 11px; font-weight: 400; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

@media (max-width: 340px) {
  .lb-row, .lb-own-dock .lb-self { gap: 10px; padding-left: 12px; padding-right: 12px; }
  .lb-number { font-size: 22px; }
}
