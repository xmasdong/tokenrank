.profile-editor .avatar-picker { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 72px; box-sizing: border-box; padding: 8px 0; margin: 8px 0; border-radius: 0; background: transparent; color: var(--text); font-weight: 400; text-align: left; line-height: 1.5; }
.profile-editor .avatar-picker::after { border: none; }
.profile-editor .avatar-picker-active { background: var(--surface-muted); }
.avatar-image, .avatar-placeholder { display: block; flex: none; width: 48px; height: 48px; box-sizing: border-box; border-radius: 50%; }
.avatar-placeholder { line-height: 48px; font-size: 20px; color: var(--text-muted); text-align: center; background: var(--separator); }
.avatar-copy { flex: 1; min-width: 0; }
.avatar-label { font-size: 15px; }
.avatar-hint { font-size: 12px; color: var(--text-secondary); margin-top: 4px; }
.avatar-arrow { flex: none; color: var(--text-muted); font-size: 22px; }
.nickname-field { margin: 16px 0; border-bottom: 1rpx solid var(--separator); }
.field-label { font-size: 12px; color: var(--text-secondary); }
.nickname-field .nickname-input, .nickname-field .nickname-activate { width: 100%; height: 48px; min-height: 48px; box-sizing: border-box; padding: 0; margin: 0; border-radius: 0; background: transparent; color: var(--text); font-size: 16px; line-height: 1.5; text-align: left; }
.nickname-field .nickname-activate { display: flex; align-items: center; gap: 12px; font-weight: 400; }
.nickname-field .nickname-activate::after { border: none; }
.nickname-value { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nickname-edit { flex: none; color: var(--link); font-size: 13px; }
.profile-editor .profile-save { width: 100%; margin: 0; }
.profile-error { margin-top: 12px; color: var(--danger); font-size: 13px; line-height: 1.7; }
