/* 微信列表式界面：白底、灰线、绿色操作、橙色用量。分享图片独立配色。 */
page {
  --surface: #FFFFFF;
  --surface-muted: #F7F7F7;
  --text: #191919;
  --text-secondary: #666666;
  --text-muted: #888888;
  --primary: #07C160;
  --primary-active: #06AD56;
  --link: #576B95;
  --amount: #D88A2D;
  --warning: #D88A2D;
  --danger: #FA5151;
  --danger-active: #E04545;
  --separator: #EDEDED;
  --separator-strong: #DDDDDD;
  background: var(--surface);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 15px;
  line-height: 1.5;
}
.display { font-weight: 600; }
.num-font { font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; font-variant-numeric: tabular-nums; }

/* 所有周期与分享类型使用同款等分标签。 */
.tabs { display: flex; gap: 0; padding: 0; background: var(--surface); border-bottom: 1rpx solid var(--separator); }
.tab { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; min-width: 0; min-height: 44px; box-sizing: border-box; padding: 0 4px; margin: 0; color: var(--text-secondary); font-size: 15px; font-weight: 400; }
.tab-active { color: var(--text); font-weight: 500; }
.tab-active::after { content: ""; position: absolute; bottom: 0; left: 50%; width: 28px; height: 2px; margin-left: -14px; background: var(--primary); }
.section-divider { border-top: 1rpx solid var(--separator); margin: 0 16px; }

.btn { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 48px; padding: 10px 16px; border-radius: 6px; font-size: 16px; font-weight: 500; line-height: 1.5; text-align: center; letter-spacing: 0; }
.btn::after { border: none; }
.btn-primary { background: var(--primary); color: #FFFFFF; }
.btn-primary:active { background: var(--primary-active); }
.btn-ghost { background: #F2F2F2; color: var(--text); border: none; font-weight: 400; }
.btn-ghost:active { background: #EDEDED; }
.btn-danger { background: var(--danger); color: #FFFFFF; }
.btn-danger:active { background: var(--danger-active); }
.btn-ghost-danger { background: #F2F2F2; color: var(--danger); border: none; font-weight: 400; }
.btn[disabled] { background: #F2F2F2; color: #C8C8C8; border: none; }

.status-line { display: flex; align-items: center; gap: 6px; color: var(--text-secondary); font-size: 13px; line-height: 1.6; }
.status-dot { width: 5px; height: 5px; flex: none; border-radius: 50%; background: var(--primary); }
.status-pending .status-dot, .status-stale .status-dot, .status-error .status-dot, .status-stopped .status-dot { background: var(--danger); }
.rank-avatar { width: 40px; height: 40px; border-radius: 50%; flex: none; }
.rank-avatar-ph { display: flex; align-items: center; justify-content: center; background: var(--separator); color: var(--text-muted); font-size: 16px; font-weight: 400; }
.ph { color: var(--text-muted); }

.sk { background: #EDEDED; border-radius: 4px; animation: sk-breathe 1.4s ease-in-out infinite; }
@keyframes sk-breathe { 0%, 100% { opacity: 1; } 50% { opacity: .55; } }
